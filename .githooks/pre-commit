#!/usr/bin/env bash
# UForm pre-commit: enforce the house style on staged changes before they land.
#
# A collection of targeted checks over the staged diff — CUDA Driver-API-only (no `<<<>>>` launches or
# Runtime API includes), namespace / include-order / Doxygen conventions, banned vocabulary, the
# no-exceptions container policy, decorative-ruler and formatter-off bans, and clang-format / cmake-format
# cleanliness. Each check inspects only the added lines of a staged file, so legacy code migrates on its
# own schedule while no new violation sneaks in, and each prints the specific reason when it fires.

set -u
export LC_ALL=C # Byte-wise regexes, immune to the committer's locale

rejection_count=0
project_include_prefix="uform"
sibling_projects='numkong|stringzilla|forkunion|smashtable|usearch|ucall|ustore'
cmake_published_variables="UFORM_IS_MAIN_PROJECT"
cmake_third_party_variables="EMSCRIPTEN_SYSTEM_PROCESSOR WASI_SDK_PATH WASI_SDK_PREFIX"

# Prints the reason and the first offending lines, and counts the rejection.
fail() { # fail <matches> <message-line>...
    local matches=$1
    shift
    local line
    for line in "$@"; do echo "pre-commit: $line"; done
    printf '%s\n' "$matches" | head -5
    rejection_count=$((rejection_count + 1))
}

# Blanks C-family comments to spaces, keeping every line and column in place, so a code check never fires
# on a comment that merely names the construct it bans. String and character literals pass through.
blank_c_comments_preserving_columns() { # blank_c_comments_preserving_columns < source
    awk '
        {
            output = ""
            for (position = 1; position <= length($0); ++position) {
                character = substr($0, position, 1)
                pair = substr($0, position, 2)
                if (state == "block") {
                    if (pair == "*/") { state = ""; output = output "  "; ++position }
                    else output = output " "
                    continue
                }
                if (state == "string" || state == "character") {
                    output = output character
                    if (character == "\\") { output = output substr($0, position + 1, 1); ++position }
                    else if ((state == "string" && character == "\"") || (state == "character" && character == "\047")) state = ""
                    continue
                }
                if (pair == "//") { tail = substr($0, position); gsub(/./, " ", tail); output = output tail; break }
                if (pair == "/*") { state = "block"; output = output "  "; ++position; continue }
                if (character == "\"") state = "string"
                else if (character == "\047") state = "character"
                output = output character
            }
            if (state != "block") state = ""
            print output
        }'
}

# Includes form groups in a fixed order with a blank line between them: the C library, the platform's own
# headers, the C++ standard library, external libraries, sibling projects, then this project's own headers:
# the top-level `uform/<name>` ones, the public `uform/<dir>/...` ones, and last the private ones spelled from
# their root. Only headers in this repository are quoted, found beside the including file or anywhere in the
# index, and public ones under `c/` always with the `project_include_prefix`. Includes under an `#if` keep
# their quoting but sit outside the grouping; an include guard is not such an `#if`. So does one a `#define`
# right above configures, as `PY_SSIZE_T_CLEAN` does CPython's, which must precede every standard header. A C
# source counts the `<name.h>` headers of its own standard library as the C library.
check_include_groups() {
    local misgrouped
    misgrouped=$(awk -v project="$project_include_prefix" -v file="$file" '
        BEGIN {
            split("cassert cctype cerrno cfenv cfloat cinttypes climits clocale cmath csetjmp csignal cstdarg " \
                  "cstddef cstdint cstdio cstdlib cstring ctime cuchar cwchar cwctype", names, " ")
            for (n in names) clibrary[names[n]] = 1
            split("dirent.h dlfcn.h errno.h fcntl.h ftw.h poll.h pthread.h sched.h signal.h stdio.h stdlib.h " \
                  "string.h time.h unistd.h io.h windows.h bcrypt.h malloc.h", names, " ")
            for (n in names) platform[names[n]] = 1
            split("assert.h ctype.h errno.h fenv.h float.h inttypes.h iso646.h limits.h locale.h math.h setjmp.h " \
                  "signal.h stdalign.h stdarg.h stdatomic.h stdbool.h stddef.h stdint.h stdio.h stdlib.h " \
                  "stdnoreturn.h string.h tgmath.h threads.h time.h uchar.h wchar.h wctype.h", names, " ")
            if (file ~ /\.[ch]$/) for (n in names) clibrary[names[n]] = 1
            split("forkunion numkong smashtable stringzilla uform usearch ustore", names, " ")
            for (n in names) sibling[names[n]] = 1
            split("C-library platform C++-standard external sibling top-level-own public-own private", labels, " ")
        }
        NR == FNR { added[$1 + 0]; next }
        { configuring = configured; configured = ($1 == "#define") }
        guard != "" && NF {
            if ($1 == "#define" && $2 == guard) { --depth; counted[level] = 0; configured = 0 }
            guard = ""
        }
        /^[[:space:]]*#[[:space:]]*if/ { ++depth; counted[++level] = 1; guard = ($1 == "#ifndef") ? $2 : "" }
        /^[[:space:]]*#[[:space:]]*endif/ { depth -= counted[level--] }
        {
            if ($0 ~ /^[[:space:]]*#[[:space:]]*include[[:space:]]*[<"]/) {
                header = $0
                quoted = ($0 ~ /include[[:space:]]*"/)
                sub(/^[^<"]*[<"]/, "", header); sub(/[>"].*$/, "", header)
                root = header; sub(/[\/.].*$/, "", root)
                touched = (FNR in added)
                if (root == project) rank = header ~ /^[^\/]+\/[^\/]+\// ? 7 : 6
                else if (header in clibrary) rank = 1
                else if ((header in platform) || header ~ /^(sys|linux|arpa|netinet|asm)\//) rank = 2
                else if (header !~ /[\/.]/) rank = 3
                else if (root in sibling) rank = 5
                else rank = 4
                if (quoted && rank < 5) {
                    directory = file; sub(/[^\/]*$/, "", directory); found = ""
                    search = "git ls-files \":(glob)**/" header "\""
                    if (touched && !system("git cat-file -e \":" directory header "\" 2>/dev/null")) found = directory header
                    else if (touched) { search | getline found; close(search) }
                    if (touched && found == "")
                        printf "line %d: \"%s\" is not in this repository - write <%s>\n", FNR, header, header
                    if (index(found, "c/" project "/") == 1)
                        printf "line %d: \"%s\" is a public header - write \"%s\"\n", FNR, header, substr(found, 3)
                    rank = 8
                }
                if (touched && quoted && rank < 6)
                    printf "line %d: \"%s\" is a %s header - write <%s>\n", FNR, header, labels[rank], header
                if (touched && !quoted && rank >= 6)
                    printf "line %d: <%s> is an own header - write \"%s\"\n", FNR, header, header
                if (depth || configuring) next
                if (touched && block && rank != block)
                    printf "line %d: a %s header shares its group with %s ones\n", FNR, labels[rank], labels[block]
                if (touched && !block && rank < previous)
                    printf "line %d: a %s group follows a %s group\n", FNR, labels[rank], labels[previous]
                if (!block) block = rank
            }
            else if ($0 !~ /^[[:space:]]*#/) { if (block) previous = block; block = 0 }
        }' "$staged_lines_path" "$staged_blob")
    [ -z "$misgrouped" ] || fail "$misgrouped" \
        "$file misgroups its includes - C library, platform, C++ standard, external, <sibling/...>, then" \
        "            \"$project_include_prefix/<name>\", \"$project_include_prefix/<dir>/...\" and private \"<dir>/...\" headers," \
        "            each group separated by a blank line:"
}
# Rejects a pipe-table row in a comment of a code file, because a header table is plain columns aligned with
# spaces, which reads the same in an editor, a terminal and a diff; pipe tables belong only in Markdown files.
check_tables_aligned_not_piped() {
    local piped
    piped=$(printf '%s\n' "$added" | grep -E '^\+[[:space:]]*(\*|//[/!]?|#)[[:space:]]+\|.*\|[[:space:]]*$' || true)
    [ -z "$piped" ] || fail "$piped" \
        "$file draws a pipe table in a comment; pipe tables belong only in Markdown, so align plain" \
        "            columns with spaces, indented 4 past the prose, as in \`*      Instruction   Notes\`:"
}

# Rejects an added banner ruler outside Markdown: a comment that opens or closes on a run of `---`, `===`, `####`,
# `////`, `***` or horizontal box-drawing strokes, a line of such runs around an optional label, or a string literal
# that prints one. Box corners and verticals stay free for diagrams, a `|` line for Markdown tables, and YAML keeps
# its `---` document marker. Reads `+` lines, or a whole diff, from stdin.
check_banners() { # check_banners <path> < added-lines
    case "$1" in
    *.c | *.h | *.cc | *.cpp | *.cxx | *.hpp | *.hxx | *.cu | *.cuh | *.hip | *.metal | *.pml | *.py | *.pyi | *.pyx | \
        *.rs | *.go | *.zig | *.mojo | *.js | *.mjs | *.cjs | *.ts | *.mts | *.tsx | *.swift | *.java | *.kt | *.cs | \
        *.toml | *.yml | *.yaml | *.cmake | *CMakeLists.txt | *.sh) ;;
    *) return 0 ;;
    esac
    local rulers
    rulers=$(awk -v path="$1" -v quote="'" '
        BEGIN {
            stroke = "(─|━|┄|┅|┈|┉|╌|╍|═)"
            run = "(---+|===+|####+|////+|\\*\\*\\*+|" stroke stroke stroke "+)"
            marker = "^(#|//|/\\*|\\*|--|;)[!/*<]?[ \t]*"
            printed = "(----+|====+|####+|" stroke stroke stroke "+)"
            literal = "[\"" quote "][ \t]*" printed "|" printed "[ \t]*[\"" quote "]"
        }
        /^\+/ {
            text = substr($0, 2); sub(/^[ \t]+/, "", text); sub(/[ \t\r]+$/, "", text)
            if (text == "---" && path ~ /\.ya?ml$/) next
            if (text ~ ("^" run "([ \t].*[ \t]" run ")?$") || text ~ (marker run "[ \t]*(\\*/)?([ \t]|$)") ||
                (text ~ marker && text ~ ("[ \t]" run "[ \t]*(\\*/)?$")) || (text ~ literal && text !~ /\|/))
                print
        }')
    [ -z "$rulers" ] && return 0
    echo "pre-commit: $1 adds a banner ruler; name a section with #pragma region or # region, or a plain sentence:"
    printf '%s\n' "$rulers" | head -5
    return 1
}

# region Comments and Prose

# ASCII "->" arrows inside comments & docstrings - prose uses the Unicode arrow (→). The pattern
# targets " -> " with surrounding spaces on comment-looking lines, so real member access like
# `pointer->field` in code never trips it.
check_ascii_arrows() {
    local arrows
    arrows=$(printf '%s\n' "$added" | grep -E '((//|/\*|^\+[[:space:]]*\*).* -> )' || true)
    [ -z "$arrows" ] || fail "$arrows" \
        "$file uses the ASCII '->' arrow in a comment - prose arrows are the Unicode →:"
}

# The same arrow rule for Markdown prose, which is every added line outside a code fence.
check_ascii_arrows_prose() {
    local arrows
    # Fenced code keeps its language's own `->`, so only lines outside ``` and ~~~ fences are prose.
    arrows=$(< "$staged_blob" LC_ALL=C awk -v lines=" $(printf '%s ' $added_lines)" '
        /^[[:space:]]*(```|~~~)/ { fenced = !fenced; next }
        !fenced && / -> / && index(lines, " " FNR " ") { print }')
    [ -z "$arrows" ] || fail "$arrows" \
        "$file uses the ASCII '->' arrow - prose arrows are the Unicode →:"
}

# The abbreviation reads ID and IDs in prose, never id, ids, Id or Ids. Only comment text is weighed: code spans,
# `@code` and `@verbatim` bodies, quoted strings, URLs, Doxygen parameter names and identifiers like `token_id`,
# `.id` or `->id` keep their spelling.
ids_miscased_pattern='(^|[^[:alnum:]_.:])(id|ids|Id|Ids)([^[:alnum:]_(]|$)'
check_ids_capitalized() {
    local miscased
    miscased=$(printf '%s\n' "$added" | awk '
        { line = substr($0, 2); gsub(/https?:\/\/[^[:space:]]*/, "", line) }
        line ~ /@end(code|verbatim)/ { code = 0; next }
        line ~ /@(code|verbatim)/ { code = 1; next }
        code { next }
        line ~ /^[[:space:]]*(\/\/|\/\*|\*)/ { print line; next }
        { position = index(line, "//"); if (position) print substr(line, position) }' |
        sed -E 's/`[^`]*`//g; s/"[^"]*"//g; s/->/ _arrow_/g; s/@(p|c|a|ref|param|tparam)[[:space:]]+[A-Za-z_][A-Za-z0-9_]*//g' |
        grep -E "$ids_miscased_pattern" || true)
    [ -z "$miscased" ] || fail "$miscased" "$file writes id or ids in a comment - the abbreviation is ID, plural IDs:"
}

# The same rule for Markdown prose, skipping fenced and indented code the added lines open themselves.
check_ids_capitalized_prose() {
    local miscased
    miscased=$(printf '%s\n' "$added" | awk '/^\+[[:space:]]*```/ { fenced = !fenced; next } !fenced && !/^\+(    |\t)/' |
        sed -E 's#https?://[^[:space:]]*##g; s/`[^`]*`//g; s/"[^"]*"//g; s/->/ _arrow_/g; s/^\+//' |
        grep -E "$ids_miscased_pattern" || true)
    [ -z "$miscased" ] || fail "$miscased" "$file writes id or ids - the abbreviation is ID, plural IDs:"
}

# Prose reads at 100 columns while code runs to clang-format's 120, so a docblock line or a whole-line `//`
# comment stops at 100. URLs, `@code` and `@verbatim` bodies are exempt, and a macro line is measured without
# the padding clang-format adds before its trailing backslash.
check_prose_comment_width() {
    local wide
    wide=$(awk '
        FILENAME == ARGV[1] { added[$1 + 0]; next }
        {
            text = $0
            if (!inside && text ~ /^[[:space:]]*\/\*([^*]|\*[^\/])*\*\/[[:space:]]*[^[:space:]\\]/) next
            if (text ~ /^[[:space:]]*\/\*/) { inside = 1; in_code = 0 }
            prose = inside || text ~ /^[[:space:]]*\/\//
            if (inside && text ~ /@(code|verbatim)/) in_code = 1
            if (inside && text ~ /@end(code|verbatim)/) in_code = 0
            if (inside && text ~ /\*\//) inside = 0
            if (!prose || in_code || !(FNR in added) || text ~ /https?:\/\//) next
            characters = text
            sub(/[[:space:]]*\\$/, "", characters)
            gsub(/[\200-\277]/, "", characters)
            if (length(characters) > 100) printf "line %d: %d columns\n", FNR, length(characters)
        }' "$staged_lines_path" "$staged_blob")
    [ -z "$wide" ] || fail "$wide" \
        "$file writes prose past 100 columns - rewrap it, only code may reach 120:"
}

# A comment line that breaks a sentence while the next word would fit under the paragraph's widest line is an
# edit nobody re-flowed. A colon ending, a URL, tags, bullets, code blocks, aligned rows and `Label:` lines start
# a new paragraph, and the measure is the paragraph's own widest other line, capped at the 100-column prose.
check_prose_paragraph_filled() {
    local underfilled
    underfilled=$(awk '
        function characters(text) { gsub(/[\200-\277]/, "", text); return length(text) }
        function first_word(text) {
            if (text ~ /^`[^`]*`/) { match(text, /^`[^`]*`[^[:space:]]*/); return substr(text, 1, RLENGTH) }
            # An inline tag moves with its argument, so the pair is what has to fit.
            if (match(text, /^@(c|p|ref|b|a|e|em)[[:space:]]+[^[:space:]]+/)) return substr(text, 1, RLENGTH)
            sub(/[[:space:]].*$/, "", text); return text
        }
        function hold_paragraph_line(line, body, width) { ++held; held_line[held] = line; held_body[held] = body; held_width[held] = width }
        function report_paragraph_room(    index_, other, measure, word) {
            for (index_ = 1; index_ < held; ++index_) {
                if (held_body[index_] ~ /[.:;!?][])"`\047]*$/) continue
                if (!((held_line[index_] in added) || (held_line[index_ + 1] in added))) continue
                measure = 0
                for (other = 1; other <= held; ++other) if (other != index_ && held_width[other] > measure) measure = held_width[other]
                if (measure > 100) measure = 100
                word = first_word(held_body[index_ + 1])
                if (held_width[index_] + 1 + characters(word) <= measure) printf "line %d: room for `%s` from the next line\n", held_line[index_], word
            }
            held = 0
        }
        function previous_text_ok(text) { return text !~ /:[[:space:]]*(\*\/)?[[:space:]]*$/ && text !~ /https?:\/\// }
        FILENAME == ARGV[1] { added[$1 + 0]; next }
        {
            text = $0
            opens = (text ~ /^[[:space:]]*\/\*/)
            if (opens) { inside = 1; in_code = 0 }
            slashed = !inside && text ~ /^[[:space:]]*\/\//
            if (inside && text ~ /@(code|verbatim)/) in_code = 1
            body = text
            sub(/[[:space:]]*\*\/[[:space:]]*$/, "", body)
            sub(/^[[:space:]]*(\/\*\*?|\*|\/\/\/?)[[:space:]]*/, "", body)
            flowing = (inside || slashed) && !in_code && body != "" && body !~ /^\||https?:\/\// &&
                body !~ /[^[:space:]]   *[^[:space:]]/ && text !~ /@end(code|verbatim)/ && text !~ /^[[:space:]]*\/\/[[:space:]]{4,}/
            block_tag = body ~ /^@[a-z]/ && body !~ /^@(c|p|ref|b|a|e|em)[[:space:]]/
            continues = flowing && !block_tag && body !~ /^(- |[0-9]+\. |[A-Z][A-Za-z]*( [A-Za-z]+)?( [A-Za-z]+)?: )/ && !opens
            if (!(continues && previous_flowing && previous_kind == (slashed ? "slashed" : "block")))
                report_paragraph_room()
            if (flowing) hold_paragraph_line(FNR, body, characters(text))
            previous_flowing = flowing && text !~ /\*\// && previous_text_ok(text)
            previous_kind = slashed ? "slashed" : "block"
            if (inside && text ~ /@end(code|verbatim)/) in_code = 0
            if (inside && text ~ /\*\//) inside = 0
        }
        END { report_paragraph_room() }' "$staged_lines_path" "$staged_blob")
    [ -z "$underfilled" ] || fail "$underfilled" \
        "$file leaves a comment line underfilled - it breaks a sentence while the next word fits under" \
        "            the paragraph's widest line, so pull the word up or re-flow:"
}

# A `#pragma region` label must be letters, digits & spaces only. clang-format tokenises the label
# as code, so a dash, ampersand, colon, or any other symbol makes it reflow the marker and the
# regions drift out of place on the next format run. Keep the label a plain phrase:
# `#pragma region Deferred Calls`.
check_region_labels() {
    local symbolic
    symbolic=$(printf '%s\n' "$added" |
        grep -E '^\+[[:space:]]*#pragma[[:space:]]+(end)?region[[:space:]]' |
        grep -E '#pragma[[:space:]]+(end)?region[[:space:]]+.*[^A-Za-z0-9 ]' || true)
    [ -z "$symbolic" ] || fail "$symbolic" \
        "$file has a symbol in a #pragma region label - write \`#pragma region Deferred Calls\`;" \
        "            clang-format reflows a label carrying anything but letters, digits & spaces:"
}

# A `#pragma region` earns its markers only around a stretch worth folding: one shorter than 30 lines
# belongs in its neighbour, so the outline stays a few meaningful sections rather than many tiny ones.
# Judged when either marker of the region is an added line.
check_region_lengths() {
    local short
    short=$(awk '
        NR == FNR { added[$1 + 0]; next }
        /^[[:space:]]*#pragma[[:space:]]+region/ { opened[++depth] = FNR; name[depth] = $0 }
        /^[[:space:]]*#pragma[[:space:]]+endregion/ && depth {
            if (FNR - opened[depth] - 1 < 30 && ((opened[depth] in added) || (FNR in added)))
                printf "line %d: %s\n", opened[depth], name[depth]
            depth--
        }' "$staged_lines_path" "$staged_blob")
    [ -z "$short" ] || fail "$short" \
        "$file has a #pragma region shorter than 30 lines - fold it into its neighbour:"
}

# Rust modules mirror files. An inline `mod name { .. }` or a `#[path = ..]` remap names a module no file
# backs; only the unit tests, `#[cfg(test)] mod tests`, stay inline.
check_rust_modules() {
    local inline
    inline=$(awk '
        /^[[:space:]]*#\[cfg\(test\)\]/ { testing = NR; next }
        /^[[:space:]]*#\[path[[:space:]]*=/ { printf "line %d: #[path] remap\n", NR }
        /^[[:space:]]*(pub(\([a-z]+\))?[[:space:]]+)?mod[[:space:]]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\{/ {
            name = $0; sub(/.*mod[[:space:]]+/, "", name); sub(/[[:space:]]*\{.*/, "", name)
            if (!(name == "tests" && testing == NR - 1)) printf "line %d: inline mod %s\n", NR, name
        }' "$staged_blob")
    [ -z "$inline" ] || fail "$inline" \
        "$file declares a module no file backs - move its items to the file root or into their own file:"
}

# Tests assert what a value is, not what its rendering happens to contain. A substring of a repr or a
# message passes on a wrong value that spells the fragment and breaks on a harmless rewording; compare the
# whole repr, the fields, the exception type or the very object raised instead.
check_substring_assertions() {
    local fragments
    fragments=$(printf '%s\n' "$added" | grep -nE \
        'pytest\.raises\([^)]*match=|["'"'"'] in (repr|str)\(|(repr|str)\([^)]*\)\.(startswith|endswith)\(|\.to_string\(\)\.(contains|starts_with|ends_with)\(|\.message\.(contains|starts_with|ends_with)\(' || true)
    [ -z "$fragments" ] || fail "$fragments" \
        "$file asserts on a fragment of a repr or a message - compare the whole value, its fields, or the exception:"
}

# A Unicode arrow glued to its neighbor - `key→id` - reads as one token to searchers and
# renderers alike; the arrow always gets whitespace on both sides.
check_glued_arrows() {
    local glued
    glued=$(printf '%s\n' "$added" | grep -E '[^[:space:]]→|→[^[:space:]]' || true)
    [ -z "$glued" ] || fail "$glued" \
        "$file glues a Unicode arrow to its neighbor - write \`key → identifier\`, never \`key→identifier\`:"
}

# Markdown paragraphs are separated by one blank line, so a run of two carries no meaning and only
# shows as noise in a diff. Fenced blocks keep whatever they hold.
check_blank_line_runs() {
    local runs
    runs=$(awk '
        /^```/ || /^~~~/ { fence = !fence }
        !fence && /^[[:space:]]*$/ { blanks++; if (blanks > 1) print NR ": consecutive blank lines"; next }
        { blanks = 0 }
    ' "$file" || true)
    [ -z "$runs" ] || fail "$runs" \
        "$file separates paragraphs with more than one blank line - Markdown needs exactly one:"
}

# Markdown tables align every pipe by display width and stay within 120 columns, so they read unwrapped.
# Width counts a UTF-8 character as one column, and the emoji these docs use as two.
check_markdown_tables() {
    local tables
    tables=$(< "$staged_blob" LC_ALL=C awk -v lines=" $(printf '%s ' $added_lines)" '
        function width(text,   copy, columns) {
            copy = text
            columns = length(text) - gsub(/[\200-\277]/, "", copy)
            copy = text
            return columns + gsub(/✅|🔜/, "", copy)
        }
        function trim(text) {
            sub(/^[[:space:]]+/, "", text)
            sub(/[[:space:]]+$/, "", text)
            return text
        }
        function check(   touched, row, body, count, columns, i, character, cell, code, escaped, cells, separator,
                          widths, column, formatted, left, right, aligned) {
            for (row = 1; row <= rows; ++row) if (index(lines, " " (first + row - 1) " ")) touched = 1
            if (!touched) return
            for (row = 1; row <= rows; ++row) {
                body = trim(table[row])
                sub(/^\|/, "", body)
                if (body ~ /\|$/ && body !~ /\\\|$/) body = substr(body, 1, length(body) - 1)
                count = 1
                cell = ""
                code = escaped = 0
                for (i = 1; i <= length(body); ++i) {
                    character = substr(body, i, 1)
                    if (escaped) escaped = 0
                    else if (character == "\\") escaped = 1
                    else if (character == "`") code = !code
                    else if (character == "|" && !code) {
                        cells[row, count++] = trim(cell)
                        cell = ""
                        continue
                    }
                    cell = cell character
                }
                cells[row, count] = trim(cell)
                if (count > columns) columns = count
            }
            separator = rows > 1
            for (column = 1; column <= columns; ++column) {
                if (cells[2, column] !~ /^:?-+:?$/) separator = 0
                widths[column] = 3
            }
            for (row = 1; row <= rows; ++row)
                for (column = 1; column <= columns; ++column)
                    if (!(separator && row == 2) && width(cells[row, column]) > widths[column])
                        widths[column] = width(cells[row, column])
            aligned = 1
            for (row = 1; row <= rows; ++row) {
                formatted[row] = "|"
                for (column = 1; column <= columns; ++column) {
                    cell = cells[row, column]
                    if (separator && row == 2) {
                        left = cell ~ /^:/
                        right = length(cell) > 1 && cell ~ /:$/
                        cell = (left ? ":" : "")
                        for (i = left + right; i < widths[column]; ++i) cell = cell "-"
                        if (right) cell = cell ":"
                    } else
                        for (i = width(cell); i < widths[column]; ++i) cell = cell " "
                    formatted[row] = formatted[row] " " cell " |"
                }
                if (formatted[row] != table[row]) aligned = 0
            }
            if (!aligned) printf "line %d: table cells are not aligned\n", first
            for (row = 1; row <= rows; ++row)
                if (width(formatted[row]) > 120)
                    printf "line %d: table row is %d columns, over 120\n", first + row - 1, width(formatted[row])
        }
        /^[[:space:]]*```/ { fenced = !fenced }
        !fenced && /^\|/ {
            if (!rows) first = NR
            table[++rows] = $0
            next
        }
        rows { check(); rows = 0 }
        END { if (rows) check() }' || true)
    [ -z "$tables" ] || fail "$tables" \
        "$file has misaligned or overwide tables - pad each cell to its column's widest, emoji counting as two columns," \
        "            fill the separator row with dashes, and shorten rows past 120 columns:"
}

# Backward-looking prose in comments - "v2", "v3", "the previous implementation" - rots the moment
# the rewrite ships and reads as changelog noise. Docstrings describe behavior on its own terms,
# forward-looking; history belongs in commit messages and design documents.
check_backward_references() {
    local backrefs
    # Case-sensitive on purpose: lowercase `v2` is a version reference, while uppercase `V2` names
    # real hardware, like the Arm Neoverse cores. Three digits name a SIMD tier like `v128`, never a version.
    # `v4` is this project's own name (UForm v4), never a past version.
    backrefs=$(printf '%s\n' "$added" | grep -E '(//|/\*|^\+[[:space:]]*\*)' |
        grep -E '\bv([0-35-9]|[1-9][0-9])\b|[Tt]he (previous|old|legacy) (design|implementation|version|draft|approach|convention|code)|\bused to (be|do|work)\b' || true)
    [ -z "$backrefs" ] || fail "$backrefs" \
        "$file cites a past version in a comment - describe the behavior on its own terms;" \
        "            history belongs in commit messages and design docs:"
}

# A design justified by another project's design ages into a lie the moment that project moves,
# and it tells a reader nothing about the code in front of them. State what it does and why.
check_sibling_justification() {
    local borrowed
    borrowed=$(printf '%s\n' "$added" | grep -inE \
        '(the (way|split|shape|idiom|dialect|convention|form|style|precedent))[^.]{0,40}(numkong|stringzilla|forkunion|sibling)|(numkong|stringzilla|forkunion|sibling)[^.]{0,40}(idiom|dialect|house style|does it|spells it|takes|would)|(matching|mirror(s|ing)?|mimic(s|king)?|copie[sd]|borrow(s|ed)?|same as) (how )?(numkong|stringzilla|forkunion|the sibling)' || true)
    [ -z "$borrowed" ] || fail "$borrowed" \
        "$file justifies a design by a sibling project - say what this code does and why," \
        "            not which repository it was copied from:"
}

# endregion Comments and Prose

# region Doxygen Blocks

# A tag continuation hangs exactly 4 columns past its `@`, and a bullet or numbered-item continuation
# aligns under the item's text, since anything else reads as a new paragraph or as ragged alignment.
# Inline tags like `@c` or `@p` opening a line continue the prose; only block tags start an entry.
check_continuation_hanging_indent() {
    local ragged
    ragged=$(awk '
        FILENAME == ARGV[1] { added[$1 + 0]; next }
        {
            text = $0
            if (text ~ /^[[:space:]]*\/\*\*/) { inside = 1; anchor = 0; in_code = 0 }
            if (!inside) next
            if (text ~ /@(code|verbatim)/) { in_code = 1; anchor = 0 }
            if (text ~ /@end(code|verbatim)/) { in_code = 0; next }
            if (text ~ /\*\//) { inside = 0; anchor = 0 }
            if (in_code) next
            if (text ~ /^[[:space:]]*(\/\*\*|\*)[[:space:]]*@(brief|param|tparam|return|returns|retval|note|warning|sa|see|throws|pre|post)([^a-z]|$)/) {
                anchor = index(text, "@") + 4; next
            }
            if (text ~ /^[[:space:]]*\*[[:space:]]+(-|[0-9]+\.) /) {
                match(text, /^[[:space:]]*\*[[:space:]]+(-|[0-9]+\.)[[:space:]]+/); anchor = RLENGTH + 1; next
            }
            block_tag = text ~ /^[[:space:]]*\*[[:space:]]*@[a-z]/ && text !~ /^[[:space:]]*\*[[:space:]]*@(c|p|ref|b|a|e|em)[[:space:]]/
            if (text ~ /^[[:space:]]*\*[[:space:]]*$/ || block_tag || text ~ /^[[:space:]]*\*\//) { anchor = 0; next }
            if (anchor && (FNR in added)) {
                match(text, /^[[:space:]]*\*[[:space:]]*/)
                if (RLENGTH + 1 != anchor) printf "line %d: continuation starts at column %d, expected %d\n", FNR, RLENGTH + 1, anchor
            }
        }' "$staged_lines_path" "$staged_blob")
    [ -z "$ragged" ] || fail "$ragged" \
        "$file misaligns a continuation line - a tag continuation hangs 4 columns past its @, a bullet or" \
        "            numbered-item continuation aligns under the item text:"
}

# Every @param declares its direction - [in]/[out]/[inout] - so a reader knows whether the callee
# reads, writes, or mutates the argument. A bare @param and the comma form @param[in,out] are both
# rejected; the one spelling for a mutated argument is @param[inout].
check_param_directions() {
    local bare
    bare=$(printf '%s\n' "$added" | grep -E '@param' | grep -vE '@param\[(in|out|inout)\]' || true)
    [ -z "$bare" ] || fail "$bare" \
        "$file has a @param without an [in]/[out]/[inout] direction - never a bare @param" \
        "            nor the comma form @param[in,out] (write @param[inout]):"
}

# Doxygen renders @b / @c, not Markdown: `__bold__` / `**bold**` in a `/** */` or `//` comment print
# literally. Use @b for a one/two-token emphasis and plain prose for anything longer. C and CUDA `__keyword__`
# spellings are exempt; Markdown files never route here.
check_markdown_doxygen() {
    local emphasis
    emphasis=$(printf '%s\n' "$added" | grep -E '^\+[[:space:]]*(\*|//)' |
        grep -oE '\*\*[^*]+\*\*|__[^_]+__' |
        grep -vE '^__(global|device|host|shared|constant|managed|restrict|inline|volatile|asm|attribute|forceinline|noinline|launch_bounds|CUDACC|CUDA_ARCH|STDC|nv_[A-Za-z0-9]+|builtin[A-Za-z0-9_]*|bfloat[0-9]+|half[0-9]*|fp[0-9]+)__$' || true)
    [ -z "$emphasis" ] || fail "$emphasis" \
        "$file uses Markdown emphasis in a Doxygen comment (it prints literally) - use @b" \
        "            for a 1-2 token emphasis, plain prose otherwise:"
}

# A Doxygen command glued to the preceding character - `(@c foo)`, `-@ref bar` - breaks syntax
# highlighting in most viewers, which only recognize the command after whitespace. Reword the
# sentence so the command stands free; parentheses around a command are the usual offender.
check_doxygen_glued() {
    local glued
    glued=$(printf '%s\n' "$added" | grep -E '^\+[[:space:]]*(\*|//)' |
        grep -E '[^[:space:]]@(brief|section|subsection|param|tparam|returns?|ref|see|note|file|date|author|c|p|b)\b' || true)
    [ -z "$glued" ] || fail "$glued" \
        "$file glues a Doxygen command to the previous character - write \`as @c foo does\`," \
        "            never \`(@c foo)\`; a highlighter only sees a command that follows whitespace:"
}

# Doxygen never parses a `//` comment, so a command there - `@p count`, `@c select_diverse` - prints literally and
# reads as noise. Plain comments name code in backticks, or in prose; the commands belong in `/** */` docblocks.
check_doxygen_in_line_comments() {
    local tagged
    tagged=$(printf '%s\n' "$added" | grep -E '(^\+|[^:])//[^/!]' |
        grep -E '//[^/!].*[[:space:]]@(brief|param|tparam|returns?|ref|see|note|c|p|b)\b' || true)
    [ -z "$tagged" ] || fail "$tagged" \
        "$file uses a Doxygen command in a // comment, which Doxygen never parses - quote code in backticks:"
}

# A `//!` trailer documents nothing an editor shows on hover, and C and C++ have no use for it: a member
# takes a `/** ... */` line above it, and a note on a statement is a plain `//` comment.
check_doxygen_trailers() {
    local trailers
    trailers=$(printf '%s\n' "$added" | grep -nE '//!' || true)
    [ -z "$trailers" ] || fail "$trailers" \
        "$file documents with a //! trailer - write /** ... */ above a member, or // after a statement:"
}

# An `@section` line reads as a heading only when air surrounds it: the comment lines directly
# above and below must be empty (`*` alone). Spacing is context, not a line, so this reads the
# whole staged file and reports only the headings the commit itself added.
check_section_spacing() {
    grep -q '@section' "$staged_blob" || return 0
    local cramped
    cramped=$(awk '
        NR == FNR { added[$1 + 0]; next }
        { lines[FNR] = $0; last = FNR }
        END {
            for (i = 1; i <= last; ++i)
                if (lines[i] ~ /@section/ && (i in added)) {
                    if (lines[i - 1] !~ /^[[:space:]]*\*[[:space:]]*$/) printf "line %d: no empty comment line above the @section\n", i
                    if (lines[i + 1] !~ /^[[:space:]]*\*[[:space:]]*$/) printf "line %d: no empty comment line below the @section\n", i
                }
        }' "$staged_lines_path" "$staged_blob")
    [ -z "$cramped" ] || fail "$cramped" \
        "$file crams an @section against its neighbors - keep one empty comment line" \
        "            above and below every @section heading:"
}

# A docblock reads as the start of something only when air sits above it, with no exception: an opening
# brace and an access specifier earn their blank line like anything else. Spacing is context rather than
# a line, so this reads the whole staged file and reports only the docblocks the commit itself added.
check_docblock_spacing() {
    local cramped
    cramped=$(awk '
        NR == FNR { added[$1 + 0]; next }
        { lines[FNR] = $0; last = FNR }
        END {
            for (i = 2; i <= last; ++i)
                if (lines[i] ~ /^[[:space:]]*\/\*\*/ && (i in added) && lines[i - 1] !~ /^[[:space:]]*$/)
                    printf "line %d: no empty line above the docblock\n", i
        }' "$staged_lines_path" "$staged_blob")
    [ -z "$cramped" ] || fail "$cramped" \
        "$file opens a docblock against the line above - every /** takes an empty line above it," \
        "            an opening brace and an access specifier included:"
}

# A `@brief` separates a summary from what follows it, so a block with nothing following carries no
# tag. Block tags are the contract trio, the file header's, and the cross-references; `@c`, `@p`,
# `@b` and `@ref` are inline markup and open nothing. A blank comment line counts too - it starts a
# body paragraph. Whole staged file, since a block is context, and only the blocks this commit added.
check_lone_brief() {
    local lone
    lone=$(awk '
        NR == FNR { added[$1 + 0]; next }
        { lines[FNR] = $0; last = FNR }
        END {
            for (i = 1; i <= last; ++i) {
                if (lines[i] !~ /^[[:space:]]*\/\*\*/) continue
                brief = 0; section = 0; blank = 0; touched = 0
                for (j = i; j <= last; ++j) {
                    if (j in added) touched = 1
                    if (lines[j] ~ /@brief/) brief = 1
                    if (lines[j] ~ /^[[:space:]]*(\/\*\*|\*)[[:space:]]*@(param|tparam|return|retval|sa|see|note|file|author|date|section|code)([^a-z]|$)/) section = 1
                    if (lines[j] ~ /^[[:space:]]*\*[[:space:]]*$/) blank = 1
                    if (lines[j] ~ /\*\//) break
                }
                if (brief && touched && !section && !blank)
                    printf "line %d: @brief with nothing to separate it from\n", i
                i = j
            }
        }' "$staged_lines_path" "$staged_blob")
    [ -z "$lone" ] || fail "$lone" \
        "$file tags a docblock that is one unstructured paragraph - drop the @brief," \
        "            it earns its place only above a body paragraph or a tag section:"
}

# The indented summary runs at most three lines; past that the remainder is a body paragraph, which
# is unindented and sits below a blank comment line.
check_brief_length() {
    local sprawling
    sprawling=$(awk '
        NR == FNR { added[$1 + 0]; next }
        { lines[FNR] = $0; last = FNR }
        END {
            for (i = 1; i <= last; ++i) {
                if (lines[i] !~ /@brief/) continue
                span = 1
                for (j = i + 1; j <= last; ++j) {
                    if (lines[j] !~ /^[[:space:]]*\*[[:space:]]{5,}[^[:space:]]/) break
                    if (lines[j] ~ /^[[:space:]]*\*[[:space:]]*@(param|tparam|return|retval|sa|see|note|file|author|date|section|code)([^a-z]|$)/) break
                    ++span
                }
                if (span > 3 && (i in added)) printf "line %d: @brief runs %d lines\n", i, span
            }
        }' "$staged_lines_path" "$staged_blob")
    [ -z "$sprawling" ] || fail "$sprawling" \
        "$file lets a @brief summary run past three lines - keep the summary short and move" \
        "            the rest into an unindented body paragraph below a blank comment line:"
}

# A file's own header names itself before it describes itself: @file, @author, @date, @brief, in that
# order, contiguous, with any prose below them, as `c/uform/train.h` opens. The header is context, so the
# staged file is read whole and judged when one of its header lines is added; a file with no header at
# all is judged when its first line is.
check_file_header() {
    local header
    header=$(awk '
        NR == FNR { added[$1 + 0]; next }
        { lines[FNR] = $0; last = FNR }
        END {
            for (i = 1; i <= last; ++i) if (lines[i] ~ /^[[:space:]]*\/\*\*/) break
            if (i > last) { if (1 in added) print "line 1: no header docblock"; exit }
            wanted = "file author date brief"; split(wanted, order, " ")
            seen = 0; blank = 0; touched = 0; findings = ""
            for (j = i; j <= last; ++j) {
                if (j in added) touched = 1
                if (lines[j] ~ /^[[:space:]]*\*[[:space:]]*$/) blank = 1
                if (match(lines[j], /@(file|author|date|brief)/)) {
                    tag = substr(lines[j], RSTART + 1, RLENGTH - 1)
                    ++seen
                    if (seen <= 4 && tag != order[seen])
                        findings = findings sprintf("line %d: @%s where @%s belongs\n", j, tag, order[seen])
                    if (blank) findings = findings sprintf("line %d: @%s sits below a blank line, outside the tag block\n", j, tag)
                }
                if (lines[j] ~ /\*\//) break
            }
            if (!touched) exit
            printf "%s", findings
            if (seen < 4) printf "line %d: the header names only %d of @file, @author, @date, @brief\n", i, seen
        }' "$staged_lines_path" "$staged_blob")
    [ -z "$header" ] || fail "$header" \
        "$file misorders its file header - name the file, then the author, the date, and the summary," \
        "            contiguously, with any prose below them:"
}

# A docblock's brackets say whether it is structured. With no block tag it is prose, so the text
# starts on the opener and closes on its last line; with one it earns dedicated `/**` and `*/` lines.
check_docblock_brackets() {
    local shape
    shape=$(awk '
        NR == FNR { added[$1 + 0]; next }
        { lines[FNR] = $0; last = FNR }
        END {
            for (i = 1; i <= last; ++i) {
                if (lines[i] !~ /^[[:space:]]*\/\*\*/) continue
                tagged = 0; touched = 0; single = (lines[i] ~ /\*\//)
                for (j = i; j <= last; ++j) {
                    if (j in added) touched = 1
                    if (lines[j] ~ /^[[:space:]]*(\/\*\*|\*)[[:space:]]*@(brief|param|tparam|return|retval|sa|see|note|file|author|date|section|code)([^a-z]|$)/) tagged = 1
                    if (lines[j] ~ /\*\//) break
                }
                bare_open = (lines[i] ~ /^[[:space:]]*\/\*\*[[:space:]]*$/)
                bare_close = (lines[j] ~ /^[[:space:]]*\*\/[[:space:]]*$/)
                expanded = (bare_open || bare_close)
                if (touched && !single) {
                    if (tagged && !expanded) printf "line %d: tagged docblock without its own /** and */ lines\n", i
                    if (!tagged && expanded) printf "line %d: untagged docblock spending lines on bare /** and */\n", i
                }
                i = j
            }
        }' "$staged_lines_path" "$staged_blob")
    [ -z "$shape" ] || fail "$shape" \
        "$file mismatches a docblock's brackets to its content - prose opens on the /** and closes" \
        "            on its last line, a tagged block takes dedicated /** and */ lines:"
}

# Member documentation is Doxygen: a bare `//` line directly above a declaration (a member or a type)
# is the banned doc style - those entities get `/** @brief ... */`. The same `Type name = ...;` shape
# inside a function body is a local variable and its `//` note is a legal implementation note, and
# this library is header-only so headers carry both - so the staged file is read whole and the brace
# stack says which scope each declaration sits in, with only the added pairings reported.
check_bare_member_docs() {
    local member_docs
    member_docs=$(awk '
        NR == FNR { added[$1 + 0]; next }
        {
            line = $0
            # Block comments are stripped first, so a brace inside a docblock never moves the stack.
            if (in_comment) { if (match(line, /\*\//)) { line = substr(line, RSTART + 2); in_comment = 0 } else next }
            gsub(/\/\*([^*]|\*[^\/])*\*\//, " ", line)
            if (match(line, /\/\*/)) { line = substr(line, 1, RSTART - 1); in_comment = 1 }
            comment_at = index(line, "//")
            code = comment_at ? substr(line, 1, comment_at - 1) : line
            if (comment_at && substr(line, comment_at + 2, 1) != "/" && code ~ /^[[:space:]]*$/) { pending = $0; pending_line = FNR }
            else if (kind[depth] == "record" && pending &&
                     code ~ /^[[:space:]]*[A-Za-z_][A-Za-z0-9_:<>,* ]* [A-Za-z_][A-Za-z0-9_]* *([={;]|$)/) {
                if ((pending_line in added) || (FNR in added)) printf "line %d:%s\n", pending_line, pending
                pending = ""
            }
            else if (code !~ /^[[:space:]]*$/) pending = ""
            # `statement` holds the declaration text since the last terminator, so a class whose
            # brace sits on a continuation line still opens a record scope.
            statement = statement " " code
            for (position = 1; position <= length(code); ++position) {
                character = substr(code, position, 1)
                if (character == "{") {
                    ++depth
                    kind[depth] = (kind[depth - 1] == "code") ? "code" \
                        : (statement ~ /(^|[^A-Za-z0-9_])(class|struct|union|enum)([^A-Za-z0-9_]|$)/) ? "record" \
                        : (statement ~ /(^|[^A-Za-z0-9_])namespace([^A-Za-z0-9_]|$)/) ? "namespace" : "code"
                    statement = ""
                } else if (character == "}") { if (depth > 0) delete kind[depth--]; statement = "" }
                else if (character == ";") statement = ""
            }
        }' "$staged_lines_path" "$staged_blob" || true)
    [ -z "$member_docs" ] || fail "$member_docs" \
        "$file documents a declaration with a bare \`//\` comment - docs are" \
        "            /** @brief ... */ blocks; \`//\` is for implementation notes inside bodies:"
}

# endregion Doxygen Blocks

# region Naming and Vocabulary

# The full `unum::uform::` spelling belongs to three places: the alias and `using` lines, the lines
# opening and closing a nested namespace, and the specializations of foreign templates -
# `std::formatter<unum::uform::core::tensor_t>`, `fmt::formatter<...>` - which have to name the type from outside.
# Everywhere else the name is already in scope - through the `uc::` / `ul::` aliases, the directive a translation
# unit opened with, or the enclosing namespace itself.
check_qualified_namespace() {
    local spelled
    spelled=$(printf '%s\n' "$added" |
        grep -vE '^\+[[:space:]]*(\*|//|/\*)' |
        grep -vE 'namespace [a-z]+ = unum::uform(::[a-z_]+)*;|(using )?namespace unum::uform(::[a-z_]+)*( \{|;)$|^\+\} // namespace unum::uform' |
        grep -vE 'struct (std|fmt)::[A-Za-z_]+<unum::uform::' |
        grep -E 'unum::uform::' || true)
    [ -z "$spelled" ] || fail "$spelled" \
        "$file spells unum::uform:: in full - the name is already in scope through the \`uc\` / \`ul\` aliases," \
        "            a \`using\` directive, or the enclosing namespace; only a std::formatter<unum::uform::...> earns it:"
}

# The namespaces a C++ source opens at file scope, as `line:name`, reading past comments, literals, and
# preprocessor lines; an anonymous namespace prints as `<anonymous>`.
top_level_namespaces() { # top_level_namespaces < source
    awk '
        continued { continued = ($0 ~ /\\$/); next }
        {
            code = ""
            for (i = 1; i <= length($0); ++i) {
                c = substr($0, i, 1)
                pair = substr($0, i, 2)
                if (state == "block") { if (pair == "*/") { state = ""; ++i } continue }
                if (state != "") {
                    if (c == "\\") ++i
                    else if (c == state) state = ""
                    continue
                }
                if (pair == "//") break
                if (pair == "/*") { state = "block"; ++i; continue }
                if (c == "\"" || c == "'\''") { state = c; continue }
                code = code c
            }
            if (state != "block") state = ""
            if (code ~ /^[[:space:]]*#/) { continued = ($0 ~ /\\$/); next }
            if (depth == 0 && match(code, /(^|[^A-Za-z0-9_])namespace([[:space:]]+[A-Za-z_][A-Za-z0-9_:]*)?[[:space:]]*\{/)) {
                name = substr(code, RSTART, RLENGTH)
                sub(/^.*namespace[[:space:]]*/, "", name)
                sub(/[[:space:]]*\{$/, "", name)
                print NR ":" (name == "" ? "<anonymous>" : name)
            }
            depth += gsub(/\{/, "{", code) - gsub(/\}/, "}", code)
        }'
}

# Namespaces mirror directories. A nameless `namespace {` hides helpers in a scope no path names, and a
# namespace no directory backs, like `loaders` in `include/uform/core/types.hpp`, invents structure the tree does not have.
# Allowed names: `unum`, `uform`, the sibling libraries' roots, and a directory on the file's path. The `c/`,
# `include/uform/` and `src/` include roots name none, so `src/core/` and `include/uform/core/` open
# `unum::uform::core` and `test/` opens `unum::uform::test`. The whole staged file, since the namespace is context.
check_namespace_directories() {
    local directory=${file%/*} allowed name misplaced=""
    [ "$directory" = "$file" ] && directory=.
    allowed=" unum uform ashvardanian numkong stringzilla forkunion "
    for name in $(printf '%s\n' "$directory" | sed -E 's#^(c|src|include/uform)/##' | tr '/' '\n'); do
        allowed="$allowed$name "
    done
    while IFS=: read -r line opened; do
        if [ -z "$opened" ]; then
            misplaced="${misplaced}line $line: a nameless namespace
"
            continue
        fi
        for name in $(printf '%s\n' "$opened" | tr ':' '\n'); do
            [ -z "$name" ] && continue
            case "$allowed" in
            *" $name "*) ;;
            *) misplaced="${misplaced}line $line: namespace $name
" ;;
            esac
        done
    done < <(awk '/^[[:space:]]*namespace([[:space:]]+[A-Za-z_][A-Za-z0-9_:]*)?[[:space:]]*\{/ {
            opened = $0; sub(/^[[:space:]]*namespace[[:space:]]*/, "", opened); sub(/[[:space:]]*\{.*/, "", opened)
            print NR ":" opened }' "$staged_blob")
    [ -z "$misplaced" ] || fail "${misplaced%$'\n'}" \
        "$file opens a namespace no directory backs - use the directory's namespace, and \`static\` for file-local helpers:"
}

# A test or benchmark harness header lives in the namespace its directory spells, `test/harness.hpp` in
# `unum::uform::test`, and opens no other at file scope. The whole staged file, since the namespace is context.
check_harness_namespace() {
    local expected="unum::uform::${file%/*}"
    expected=${expected//\//::}
    local misplaced
    misplaced=$(top_level_namespaces < "$staged_blob" |
        awk -F: -v expected="$expected" '
            { ++opened; if (substr($0, index($0, ":") + 1) != expected) print "line " $0 }
            END { if (!opened) print "line 1: no namespace" }')
    [ -z "$misplaced" ] || fail "$misplaced" \
        "$file is a harness header outside \`namespace $expected\` - its directory names the namespace," \
        "            and no other opens at file scope:"
}

# A namespace opens once per file: closing it only to reopen it splits its body around whatever sits between,
# usually an include that belongs in the preamble or a handle completed between two halves. The one gap allowed
# holds a `fmt::` or `std::` specialization, which has to follow the type it formats or hashes and precede the
# first use, all outside the namespace. The whole staged file, since the namespace is context.
check_namespace_reopened() {
    local namespaces reopened
    namespaces=$(top_level_namespaces < "$staged_blob")
    [ -n "$namespaces" ] || return 0
    reopened=$(printf '%s\n' "$namespaces" |
        awk -F: -v path="$file" '
            NR == FNR {
                name = substr($0, index($0, ":") + 1)
                if (name in opened) reopening[$1 + 0] = name
                opened[name]
                next
            }
            { lines[FNR] = $0 }
            END {
                for (line in reopening) {
                    foreign = 0
                    for (gap = line - 1; gap > 0 && lines[gap] !~ ("^\\} // namespace " reopening[line] "$"); --gap)
                        if (lines[gap] ~ /^struct (fmt|std)::[a-z_]+</) foreign = 1
                    if (!foreign) printf "%s:%d: reopens namespace %s\n", path, line, reopening[line]
                }
            }' - "$staged_blob")
    [ -z "$reopened" ] || fail "$reopened" \
        "$file reopens namespace ${reopened##*namespace } - keep includes in the preamble and open each namespace once:"
}

# A class template never takes the `_t` suffix, nor a variable template `_k`: `_t` marks a concrete type or the alias a
# template materializes, and `_k` a concrete constant, so `template <...> struct fold_run_t` reads as a type the reader
# could name without arguments. Name the template bare - `humanized<value_type_>`, `device_resident<index_type_>` - and
# keep the suffixes for what it produces.
check_template_type_suffixes() {
    local suffixed variables
    suffixed=$(printf '%s\n' "$added" | awk '
        /^\+[[:space:]]*template[[:space:]]*</ {
            if ($0 ~ /(struct|class)[[:space:]]+[A-Za-z0-9_]+_t([^A-Za-z0-9_]|$)/) print
            pending = 1
            next
        }
        pending && /^\+[[:space:]]*requires/ { next }
        pending && /^\+[[:space:]]*(struct|class)[[:space:]]+[A-Za-z0-9_]+_t([^A-Za-z0-9_]|$)/ { print }
        { pending = 0 }' || true)
    [ -z "$suffixed" ] || fail "$suffixed" \
        "$file names a class template with the _t suffix - name the template bare, as in" \
        "            \`template <typename value_type_> struct humanized\`, and keep _t for its aliases:"
    variables=$(printf '%s\n' "$added" | awk '
        function suffixed(line) { return line ~ /constexpr[[:space:]][^=(]*[[:space:]][A-Za-z0-9_]*_[kt][[:space:]]*=/ }
        /^\+[[:space:]]*template[[:space:]]*</ { if (suffixed($0)) print; else pending = 1; next }
        pending && /^\+[[:space:]]*requires/ { next }
        pending && suffixed($0) { print }
        { pending = 0 }' || true)
    [ -z "$variables" ] || fail "$variables" \
        "$file names a variable template with the _k or _t suffix - name the template bare, as in" \
        "            \`template <typename index_type_> constexpr bool device_resident\`:"
}

# A template takes a bare name - `struct humanized`, never `struct humanized_gt` or `using reader_at`: template
# parameters end in a single underscore, and `_t` marks only a materialized type. Only the name a `template` head
# introduces is judged, so a local named for what it reads at an index, like `byte_at`, passes.
check_suffixed_template_names() {
    local suffixed
    suffixed=$(printf '%s\n' "$added" | blank_c_comments_preserving_columns |
        sed -e 's/R"\([A-Za-z_]*\)(.*)\1"/""/g' -e 's/"[^"]*"/""/g' |
        awk '
            function suffixed(line) {
                return line ~ /(^|[^A-Za-z0-9_])(class|struct|union|using)[[:space:]]+[A-Za-z_][A-Za-z0-9_]*_(gt|at)([^A-Za-z0-9_]|$)/ ||
                    line ~ /[A-Za-z0-9_>*&][[:space:]]+[A-Za-z_][A-Za-z0-9_]*_(gt|at)[[:space:]]*[(=]/
            }
            /^\+[[:space:]]*template[[:space:]]*</ { if (suffixed($0)) print; else pending = 1; next }
            pending && /^\+[[:space:]]*requires/ { next }
            pending && suffixed($0) { print }
            { pending = 0 }' || true)
    [ -z "$suffixed" ] || fail "$suffixed" \
        "$file names a template with a _gt or _at suffix - write \`template <typename value_type_> struct humanized\`:"
}

# Private and protected data members end in an underscore, so a reader tells state from locals at a glance. The
# staged file is read whole, since access is context: a class starts private, a struct public, and every access
# specifier changes the section; only the added declarations are reported.
check_private_member_underscores() {
    local members
    members=$(awk '
        NR == FNR { added[$1 + 0]; next }
        {
            line = $0
            if (in_comment) { if (match(line, /\*\//)) { line = substr(line, RSTART + 2); in_comment = 0 } else next }
            gsub(/\/\*([^*]|\*[^\/])*\*\//, " ", line)
            if (match(line, /\/\*/)) { line = substr(line, 1, RSTART - 1); in_comment = 1 }
            sub(/\/\/.*/, "", line)
            if (kind[depth] ~ /^record/ && line ~ /^[[:space:]]*(public|protected|private)[[:space:]]*:/) {
                match(line, /(public|protected|private)/); access[depth] = substr(line, RSTART, RLENGTH)
            }
            else if (kind[depth] ~ /^record/ && access[depth] != "public" && (FNR in added) &&
                     line ~ /^[[:space:]]*[A-Za-z_][A-Za-z0-9_:<>,*& ]*[[:space:]*&]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]*(\[[^]]*\])?[[:space:]]*(=[^;]*|\{[^}]*\})?;[[:space:]]*$/ &&
                     line !~ /^[[:space:]]*(using|typedef|friend|return|static[[:space:]]+constexpr|enum|class|struct)[[:space:]]/ &&
                     line !~ /\(/) {
                name = line; sub(/[[:space:]]*(\[[^]]*\])?[[:space:]]*(=[^;]*|\{[^}]*\})?;[[:space:]]*$/, "", name); sub(/.*[[:space:]*&]/, "", name)
                if (name !~ /_$/ && name !~ /_k$/) printf "line %d: %s\n", FNR, $0
            }
            statement = statement " " line
            for (position = 1; position <= length(line); ++position) {
                character = substr(line, position, 1)
                if (character == "{") {
                    ++depth
                    head = statement
                    if (match(head, /template[[:space:]]*<.*>[[:space:]]*(struct|class|union)[[:space:]]/)) {
                        keyword = substr(head, RSTART, RLENGTH); sub(/.*>[[:space:]]*/, "", keyword)
                        head = substr(head, 1, RSTART - 1) keyword substr(head, RSTART + RLENGTH)
                    }
                    if (kind[depth - 1] == "code") kind[depth] = "code"
                    else if (head ~ /(^|[^A-Za-z0-9_])class([^A-Za-z0-9_]|$)/) { kind[depth] = "record"; access[depth] = "private" }
                    else if (head ~ /(^|[^A-Za-z0-9_])(struct|union)([^A-Za-z0-9_]|$)/) { kind[depth] = "record"; access[depth] = "public" }
                    else if (statement ~ /(^|[^A-Za-z0-9_])(namespace|extern)([^A-Za-z0-9_]|$)/) kind[depth] = "namespace"
                    else kind[depth] = "code"
                    statement = ""
                } else if (character == "}") { if (depth > 0) { delete kind[depth]; delete access[depth]; --depth }; statement = "" }
                else if (character == ";") statement = ""
            }
        }' "$staged_lines_path" "$staged_blob" || true)
    [ -z "$members" ] || fail "$members" \
        "$file declares a private or protected data member without a trailing underscore - write \`size_\`:"
}

# Template type parameters carry a trailing underscore - `typename variant_type_`, never
# `typename multi_t` - a special case of the underscore marking internal symbols: a
# parameter is internal to its template, exists only to be materialized, and must never
# collide with the public `_t` aliases and `_k` constants it produces. Dependent-name uses
# (`typename foo_::bar`) never match, since the `::` breaks the identifier early.
check_template_parameter_underscores() {
    local bare
    bare=$(printf '%s\n' "$added" |
        grep -vE '^\+[[:space:]]*(\*|//|/\*)' |
        grep -E 'typename ?(\.\.\.)? +([A-Za-z][A-Za-z_0-9]*[A-Za-z0-9]|[A-Za-z]) *(,|>|=|$)' || true)
    [ -z "$bare" ] || fail "$bare" \
        "$file declares a template type parameter without the trailing underscore - write" \
        "            \`template <typename scalar_type_>\`, so it cannot collide with the _t alias it materializes:"
}

# Function-like ALL_CAPS macros - every macro here is object-like: include guards, config
# flags, platform shims. Preprocessor codegen hides the very lines a reader greps for, so
# write the expansion out; a truly unavoidable file-local generator is snake_case_ + #undef.
check_function_like_macros() {
    local generators
    generators=$(printf '%s\n' "$added" | grep -E '^\+[[:space:]]*#[[:space:]]*define[[:space:]]+[A-Z][A-Z0-9_]*\(' || true)
    [ -z "$generators" ] || fail "$generators" \
        "$file defines a function-like ALL_CAPS macro - write the expansion out, or name a" \
        "            file-local generator snake_case_ and #undef it after use:"
}

# A bare `bool` parameter is unreadable at the call site - `setup(n, true, false)` names
# nothing. Public headers spell the choice with a two-value enum; predicate helpers in
# tests & benches, where the bool IS the domain, stay out of scope.
# Rows turn into segments in one place, `batch_capacity` in src/train/base.cu, and bags in the
# dataset source; a budget reassigned along another path drifts, as `--rows` once set segments to rows.
check_budget_writers() {
    case "$file" in src/train/base.cu | src/train/datasets.cu | src/train.cpp) return ;; esac
    local writers
    writers=$(printf '%s\n' "$added" | grep -E '\.max_(segments|bags)_per_gpu[[:space:]]*=[^=]' || true)
    [ -z "$writers" ] || fail "$writers" \
        "$file writes a segment or bag budget - derive it through \`batch_capacity\` in src/train/base.cu:"
}

check_boolean_parameters() {
    local flags
    flags=$(printf '%s\n' "$added" | grep -E '[(,] ?bool [a-z_]+' | grep -vE '\bfor \(bool [a-z_]+ :' || true)
    [ -z "$flags" ] || fail "$flags" \
        "$file takes a bare bool parameter - name both states, as in" \
        "            \`enum class ordering_t : bool { ascending_k, descending_k };\`:"
}

# A function that opens with `auto` and names its result after the signature buries the one thing a
# reader scans a header for. Spell the type first, qualifying it where an out-of-class definition
# needs it. Lambdas, deduction guides and `requires` clauses keep their arrows - they have no other
# spelling - so the rejected shapes are a declaration opening with `auto`, and a wrapped signature
# whose continuation line opens with the arrow. Member access binds its arrow tight, which is what
# separates `index->search` from a return type.
check_trailing_returns() {
    local trailing
    trailing=$(printf '%s\n' "$added" |
        grep -nE '^\+[[:space:]]*((static|inline|constexpr|friend)[[:space:]]+)*auto[[:space:]]+[A-Za-z_].*->[[:space:]]|^\+[[:space:]]*->[[:space:]]' |
        grep -vE '\[[^]]*\][[:space:]]*\(|requires|concept' || true)
    [ -z "$trailing" ] || fail "$trailing" \
        "$file declares a trailing return type - write \`status_t insert(key_t key)\`," \
        "            not \`auto insert(key_t key) -> status_t\`:"
}

# A hand-rolled ceiling division - `(value + divisor - 1) / divisor` - re-derives what the shared
# vocabulary already names. Use `divide_round_up` from include/uform/core/types.hpp.
check_hand_ceils() {
    local ceils
    ceils=$(printf '%s\n' "$added" | grep -vE 'divide_round_up|round_up_to_multiple' |
        grep -E '\([^()]+\+[^()]+-[[:space:]]*1[[:space:]]*\)[[:space:]]*/' || true)
    [ -z "$ceils" ] || fail "$ceils" \
        "$file hand-rolls a ceiling division - write divide_round_up(value, divisor) from uform/core/types.hpp:"
}

# C's limit macros - `INFINITY`, `NAN`, `SIZE_MAX`, `PTRDIFF_MAX`, `FLT_MAX` and kin - name what
# `std::numeric_limits` spells per type, so a C++ line writes `lowest()`, `max()`, `quiet_NaN()` or
# `infinity()`. Preprocessor lines, comments and string literals stay out; the C sources keep the macros.
check_c_limit_macros() {
    local macros
    macros=$(printf '%s\n' "$added" | grep -vE '^\+[[:space:]]*(#|//|/\*|\*( |/|$))' | sed -E 's/"([^"\\]|\\.)*"//g' |
        grep -E '\b(INFINITY|NAN|HUGE_VALF?|SIZE_MAX|PTRDIFF_(MAX|MIN)|U?INT(8|16|32|64)?_(MAX|MIN)|U?L?LONG_(MAX|MIN)|(FLT|DBL)_(MAX|MIN|EPSILON))\b' || true)
    [ -z "$macros" ] || fail "$macros" \
        "$file spells a C limit macro - write std::numeric_limits<type>::lowest(), max(), quiet_NaN() or infinity():"
}

# endregion Naming and Vocabulary

# region C++ Surface and Containers

# C stdio printing in C++ sources: the suites, benchmarks and tools print through fmt::, and the libraries never
# print. A kernel has no fmt:: either, so it counts what it drops into a word its caller reads back. The C tests
# under c/ keep their stdio; the dispatch below only routes C++ translation units here.
check_printf() {
    local prints
    prints=$(blank_c_comments_preserving_columns < "$staged_blob" | awk '
        NR == FNR { added[$1 + 0]; next }
        (FNR in added) && /(^|[^A-Za-z0-9_])((f|s|sn)?printf|puts)[[:space:]]*\(/ {
            printf "line %d: %s\n", FNR, $0
        }' "$staged_lines_path" - || true)
    [ -z "$prints" ] || fail "$prints" \
        "$file prints through the C stdio family - write fmt::println(\"{} rows\", count):"
}

# A `fmt::print` whose literal does not end in a newline is half a line, and the other half arrives in a second
# call - `fmt::styled` and `fmt::join` fold both halves into one `println`. A literal opening with a carriage
# return is a redraw, never a fragment.
check_partial_prints() {
    local partial
    partial=$(printf '%s\n' "$added" | grep -E 'fmt::print\(' | grep -vE '\\n"' | grep -vE 'fmt::print\("\\r' || true)
    [ -z "$partial" ] || fail "$partial" \
        "$file prints half a line - fold it into one fmt::println, with fmt::styled or fmt::join:"
}

# C++ iostreams - `std::cout`, `std::ifstream`, `std::ostringstream`, and the rest of the
# `std::*stream` family - are banned wholesale: locale-dependent, allocation-happy, and verbose.
# Printing goes through fmt::, file reading through the C stdio family or mmap views.
check_stl_streams() {
    local streams
    streams=$(printf '%s\n' "$added" |
        grep -E 'std::[a-z_]*stream|std::(cout|cerr|cin|clog|endl)\b|#[[:space:]]*include[[:space:]]*<(iostream|sstream|fstream|ostream|istream|iomanip)>' || true)
    [ -z "$streams" ] || fail "$streams" \
        "$file uses C++ iostreams - print through fmt::, read files through C stdio or mmap:"
}

# `std::deque` - a chunked indirection-heavy container with unpredictable locality. Address
# stability comes from reserved vectors of `unique_ptr`, arenas, or ForkUnion's containers.
check_deque() {
    local deques
    deques=$(printf '%s\n' "$added" |
        grep -E 'std::deque\b|#[[:space:]]*include[[:space:]]*<deque>' || true)
    [ -z "$deques" ] || fail "$deques" \
        "$file uses std::deque - reach for reserved unique_ptr vectors, arenas, or ForkUnion containers:"
}

# `std::filesystem` throws, allocates paths behind the caller's back, and is missing or partial on several targets the
# bindings ship to. The library and its bindings reach files through the C library and mmap views; only the test,
# benchmark and tool harnesses may include `<filesystem>`.
check_filesystem_in_library() {
    local hits
    hits=$(printf '%s\n' "$added" | blank_c_comments_preserving_columns |
        grep -E '\bstd::filesystem\b|#[[:space:]]*include[[:space:]]*<filesystem>' || true)
    [ -z "$hits" ] || fail "$hits" \
        "$file uses std::filesystem in library code - it is allowed only in test/, bench/ and tools/ harnesses:"
}

# Reinterpreting copies in C++ sources - a `memcpy` between two objects whose byte count is one
# object's `sizeof` is a type pun, and `std::bit_cast` states it outright. Byte moves keep their
# memcpy: a runtime-sized bulk copy, or one object serialized into or out of a byte run.
check_memcpy() {
    local puns
    # A pun takes the address of both objects and a lone `sizeof(...)` byte count; a copy whose
    # source or destination is a byte pointer is a serialization and passes.
    puns=$(printf '%s\n' "$added" | grep -E '\bmemcpy[[:space:]]*\([[:space:]]*&[^,]*,[[:space:]]*&' |
        grep -E ',[[:space:]]*sizeof[[:space:]]*\([^)]*\)[[:space:]]*\)' || true)
    [ -z "$puns" ] || fail "$puns" \
        "$file reinterprets one object through memcpy - write \`auto bits = std::bit_cast<u64_t>(value);\`:"
}

# C++ sources call the C library through `std::`: `std::sqrt` over `sqrtf`, `std::memcpy` over `memcpy`,
# `std::strtoull` over `strtoull`. The standard promises the names only inside `std::`, and the
# overloaded forms keep the operand's type, so no `f`-suffixed spelling or widening cast is needed.
# CUDA intrinsics such as `rsqrtf` and `__expf` have no `std::` twin and pass. A type or a `>` before
# the name makes the line a declaration, which is not a call.
check_libc_qualified() {
    local calls
    calls=$(printf '%s\n' "$added" | blank_c_comments_preserving_columns | sed -E 's/"([^"\\]|\\.)*"//g' |
        awk '{
            rest = $0
            while (match(rest, /(^|[^:.>[:alnum:]_])(sqrtf?|cbrtf?|expf?|exp2f?|expm1f?|logf?|log2f?|log10f?|log1pf?|powf?|fabsf?|floorf?|ceilf?|roundf?|truncf?|fmodf?|fminf?|fmaxf?|hypotf?|sinf?|cosf?|tanf?|tanhf?|atan2f?|erff?|ldexpf?|frexpf?|nextafterf?|abs|labs|llabs|memcpy|memmove|memset|memcmp|memchr|strlen|strcmp|strncmp|strchr|strrchr|strstr|strtol|strtoll|strtoul|strtoull|strtof|strtod|atoi|atol|atof|getenv|qsort|bsearch|malloc|calloc|realloc|free)[[:space:]]*\(/)) {
                lead = substr(rest, RSTART, 1) ~ /[[:alpha:]]/ ? "" : substr(rest, 1, RSTART)
                rest = substr(rest, RSTART + RLENGTH)
                sub(/[[:space:]*&]+$/, "", lead)
                word = match(lead, /[[:alnum:]_]+$/) ? substr(lead, RSTART, RLENGTH) : ""
                if (lead ~ />$/ || (word != "" && word !~ /^(return|else|do|case|co_return|co_yield|co_await)$/)) continue
                print
                next
            }
        }' || true)
    [ -z "$calls" ] || fail "$calls" \
        "$file calls the C library unqualified - write \`1.0f / std::sqrt(f32_t {head_dim})\`, whose float" \
        "            overload replaces sqrtf, and std::memcpy or std::strtoull for the rest:"
}

# A tensor indexes by its rank, `t[row, column]`, never by `t[row * columns + column]`: the
# multidimensional subscript carries its extents and strides, while the flat form hides them and
# breaks the day a stride changes. A subscript that multiplies and adds is the flat form, whether
# it addresses a raw buffer or folds two axes into one of a view's.
check_flat_subscripts() {
    local flat
    flat=$(printf '%s\n' "$added" | blank_c_comments_preserving_columns | sed -E 's/"([^"\\]|\\.)*"//g' |
        awk '{
            rest = $0
            while (match(rest, /\[[^][]*\]/)) {
                inside = substr(rest, RSTART + 1, RLENGTH - 2)
                rest = substr(rest, RSTART + RLENGTH)
                gsub(/\+\+|\+=/, "", inside)
                if (inside ~ /[[:alnum:]_)][[:space:]]*\*[[:space:]]*[[:alnum:]_(]/ && inside ~ /\+/) {
                    print
                    next
                }
            }
        }' || true)
    [ -z "$flat" ] || fail "$flat" \
        "$file addresses a tensor through flat arithmetic - index its rank-2 or rank-3 view," \
        "            \`f32r2_view_t const rows {data, tokens, hidden};\` then \`rows[token, channel]\`:"
}

# A view slices through the subscript, `t[nk::range(0, rows), nk::slice]`, the same operator that
# reads its scalars; the call form `t(nk::range(0, rows), nk::slice)` reads as a function call.
check_call_slicing() {
    local calls
    calls=$(printf '%s\n' "$added" | blank_c_comments_preserving_columns |
        grep -E '[[:alnum:]_\])][[:space:]]*\((nk::range[[:space:]]*\(|nk::all\b|nk::slice\b)' || true)
    [ -z "$calls" ] || fail "$calls" \
        "$file slices a view through call syntax - write the subscript," \
        "            \`rows[nk::range(0, live), nk::slice]\`:"
}

# Tests and benchmarks reduce through NumKong, which accumulates in a fixed order and compensates
# Float64, instead of loops widening BFloat16 one element at a time: widen a buffer once with
# `nk::cast`, then reduce it with `nk::dot`, `nk::dots_unpacked` or `nk::reduce_moments`.
check_widened_accumulation() {
    local loops
    loops=$(printf '%s\n' "$added" | blank_c_comments_preserving_columns | grep -E '\+=' |
        grep -E '__bfloat162float[[:space:]]*\(|__half2float[[:space:]]*\(' || true)
    [ -z "$loops" ] || fail "$loops" \
        "$file accumulates hand-widened BFloat16 - widen once with nk::cast, then reduce with" \
        "            nk::dot, nk::dots_unpacked or nk::reduce_moments:"
}

# `.data()` as an emptiness probe reads as pointer plumbing; every NumKong tensor, view,
# and span - like the STL containers - spells it `empty()`.
check_data_null_probe() {
    local probes
    probes=$(printf '%s\n' "$added" |
        grep -E '![A-Za-z_][A-Za-z0-9_.]*\.data\(\)|\.data\(\) *== *nullptr' || true)
    [ -z "$probes" ] || fail "$probes" \
        "$file probes emptiness through .data() - write \`if (values.empty())\`:"
}

# Calling a call's result the same way: `vectors.view()(range, slice)` reads as a typo and hides which object
# the second call lands on. NumKong's owning tensors slice themselves - `vectors(range, slice)` - and any other
# first result takes a name before it is called.
check_call_chained_call() {
    local chained
    chained=$(printf '%s\n' "$added" | grep -E '[A-Za-z0-9_>]\(\)\(' | grep -v 'operator()(' || true)
    [ -z "$chained" ] || fail "$chained" \
        "$file calls a call result - slice an owning tensor directly, or name the first result:"
}

# The `&*iterator` antipattern - laundering an iterator through a reference into a pointer. Take the
# container's `data()`, or address the element itself.
check_iterator_laundering() {
    local laundered
    laundered=$(printf '%s\n' "$added" | grep -E '&\*[A-Za-z_]' || true)
    [ -z "$laundered" ] || fail "$laundered" \
        "$file launders an iterator through &* - write \`values.data() + offset\`, or address the element:"
}

# The library is noexcept end to end: a C verb reports failure through its status, and an exception escaping into the
# C ABI terminates the caller's process. A `throw` or a `noexcept(false)` here would break that.
check_in_house_never_throws() {
    local throwing
    throwing=$(printf '%s\n' "$added" | blank_c_comments_preserving_columns | sed -E 's/"([^"\\]|\\.)*"//g' |
        grep -E '\bthrow\b|noexcept[[:space:]]*\([[:space:]]*false[[:space:]]*\)' || true)
    [ -z "$throwing" ] || fail "$throwing" \
        "$file throws in library code - answer a status_t or an expected, since every C verb above it is noexcept:"
}

# Every library function promises not to throw, so the compiler drops the unwinding paths and a reader never wonders.
# Signatures are joined across lines, and control statements, `_foreach` loop macros, lambdas, types, `__global__`
# kernels and the `uform_*` C exports, which a C header declares, are skipped. A helper that lets a vendor's exceptions
# reach its caller's `try`, as cuDF's do, carries the `vendor-boundary` marker on a line of its signature.
check_in_house_noexcept() {
    local missing
    missing=$(< "$staged_blob" awk -v lines=" $(printf '%s ' $added_lines)" '
        function reset() { head = ""; first = 0; touched = 0; marked = 0 }
        function open_parentheses(text) { return gsub(/\(/, "(", text) - gsub(/\)/, ")", text) }
        {
            if ($0 ~ /vendor-boundary/) marked = 1
            line = $0
            sub(/[[:space:]]*\/\/.*$/, "", line)
            if (line ~ /^[[:space:]]*(\/\*|\*|#|$)/ || line ~ /^[[:space:]]*((public|private|protected|default)[[:space:]]*:|case )/) {
                reset()
                next
            }
            if (!first) first = NR
            if (index(lines, " " NR " ")) touched = 1
            opened = line
            if (opened ~ /\) ?(const )?\{.*\}[[:space:]]*;?[[:space:]]*$/) sub(/\{.*$/, "{", opened)
            head = head " " opened
            if (opened !~ /\{[[:space:]]*$/) {
                if (line ~ /[;}][[:space:]]*$/ && open_parentheses(head) <= 0) reset()
                next
            }
            text = head
            gsub(/[[:space:]]+/, " ", text)
            sub(/^ /, "", text)
            defines = text ~ /\)( const)?( ->[^{]*)? \{$/ || text ~ /\) : [^{]*\{$/
            control = text ~ /^(if|else|for|while|switch|catch|do|return|\}|[a-z_]+_foreach ?\()/ || text ~ /(^| )(if|for|while|switch) \(/
            skipped = text ~ /\[[^]]*\] ?\(|= ?\[|(^| )(struct|class|union|enum|namespace|extern|concept|requires|__global__) |(^|[ *&])uform_[a-z_]+\(/
            if (touched && defines && !control && !skipped && !marked && text !~ /noexcept/) print first ": " text
            reset()
        }' || true)
    [ -z "$missing" ] || fail "$missing" \
        "$file defines a library function without noexcept - the library never throws:"
}

# GCC atomic builtins fork the memory-model dialect. In-place words go through the class's
# ForkUnion atomic reference with explicit `std::memory_order` - the same words the ForkUnion
# waiters monitor, so loads, stores & waits compose.
check_gcc_atomics() {
    local builtins
    builtins=$(printf '%s\n' "$added" | grep -E '__atomic_[a-z_]+|__builtin_[a-z_]+|__ATOMIC_[A-Z_]+' || true)
    [ -z "$builtins" ] || fail "$builtins" \
        "$file uses a GCC atomic builtin - write atomic_ref_type_ {word}.load(std::memory_order_acquire)" \
        "            through the class's fu atomic reference, naming the memory order at every access:"
}

# Host threads managing GPUs in CUDA sources - fleets of NVLink-resident devices are
# orchestrated with per-device non-blocking streams and events from one host thread: kernel
# launches are already asynchronous, cross-device ordering is `cuStreamWaitEvent`, and
# completion is an event-sync loop, so `std::thread` adds nothing but scheduling noise.
check_host_threads() {
    local threads
    threads=$(printf '%s\n' "$added" |
        grep -E '\bstd::(thread|jthread|async)\b|#include[[:space:]]*<thread>|\bpthread_' || true)
    [ -z "$threads" ] || fail "$threads" \
        "$file spawns host threads in a GPU backend - orchestrate devices with per-device" \
        "            non-blocking CUstream + CUevent from one host thread:"
}

# A library type derives from none: a base couples one type's layout and lifetime to another's, so shared behavior is a
# member the type holds. Nor does library code lock through the standard mutexes and condition variables: it serializes
# through the ForkUnion locks and waiters its caller passes. A `std::formatter` specialization keeps its parent, since
# its qualified name never matches.
check_inheritance_and_locks() {
    local derived locks
    derived=$(printf '%s\n' "$added" | blank_c_comments_preserving_columns | sed -E 's/"([^"\\]|\\.)*"//g' |
        grep -E '(^|[^A-Za-z0-9_])(struct|class)[[:space:]]+((alignas\([^)]*\)|\[\[[^]]*\]\])[[:space:]]+)*[A-Za-z_][A-Za-z0-9_]*(<[^;{]*>)?([[:space:]]+final)?[[:space:]]*:([^:]|$)|^\+[[:space:]]*:[[:space:]]*(public|protected|private|virtual)[[:space:]]' |
        grep -vE '(^|[^A-Za-z0-9_])enum[[:space:]]+(class|struct)[[:space:]]' || true)
    [ -z "$derived" ] || fail "$derived" \
        "$file derives one type from another in library code - hold the shared part as a member:"
    locks=$(printf '%s\n' "$added" | blank_c_comments_preserving_columns |
        grep -E '\bstd::([a-z_]*mutex|lock_guard|unique_lock|shared_lock|scoped_lock|condition_variable[a-z_]*)\b|#[[:space:]]*include[[:space:]]*<(thread|mutex|shared_mutex|condition_variable)>' || true)
    [ -z "$locks" ] || fail "$locks" \
        "$file locks through the standard library in library code - take the ForkUnion lock or waiter the caller passes:"
}

# Shared words go through the class's ForkUnion atomic reference and waiter, which src/ picks per CPU class.
check_standard_atomics() {
    local atomics
    atomics=$(printf '%s\n' "$added" | blank_c_comments_preserving_columns |
        grep -nE '\bstd::atomic(_ref|_flag)?\b|#[[:space:]]*include[[:space:]]*<atomic>|\.notify_(all|one)[[:space:]]*\(' || true)
    [ -z "$atomics" ] || fail "$atomics" \
        "$file uses a standard atomic - take the class's fu atomic reference and wait through its waiter:"
}

# Scalar NumKong in a hardware path and runtime dispatch in an engine both bypass the class's kit. A `_serial` kernel
# is named only by the serial kit's `static constexpr auto` rows and the test oracles, and a `_best` one is called
# outside the harnesses only as NumKong's runtime verbs: allocator init, stream sync and device listing.
check_numkong_dispatch() {
    local serial= dispatching= calls
    case "$file" in
    test/*) ;;
    *)
        serial=$(printf '%s\n' "$added" | blank_c_comments_preserving_columns |
            grep -nE '\bnk_[a-z0-9_]+_serial[[:space:]]*\(|\bnk_[a-z0-9]+_to_[a-z0-9]+_serial\b' |
            grep -vE 'static constexpr auto [a-z0-9_]+ = nk_[a-z0-9_]+_serial;' || true)
        ;;
    esac
    case "$file" in
    include/* | src/*)
        dispatching=$(printf '%s\n' "$added" | blank_c_comments_preserving_columns |
            grep -nE '\bnk_[a-z0-9_]+_best[[:space:]]*\(' |
            grep -vE 'nk_(allocator_init|stream_synchronize|device)[a-z_]*_best' || true)
        ;;
    esac
    calls=$(printf '%s\n%s\n' "$serial" "$dispatching" | grep -v '^$' || true)
    [ -z "$calls" ] || fail "$calls" \
        "$file calls a serial or dispatching NumKong kernel - name the class kit's kernel instead:"
}

# An engine takes kits, never the mask they were picked under: no `nk_capability_t` member, local or function
# parameter appears under include/, except a kit's own `capability_k`.
check_capability_masks_in_engines() {
    local masks
    masks=$(printf '%s\n' "$added" | blank_c_comments_preserving_columns |
        grep -E '^\+[[:space:]]*((static|inline|constexpr)[[:space:]]+)*nk_capability_t([[:space:]]+const)?[[:space:]]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]*(;|=|\{)|[(,][[:space:]]*nk_capability_t([[:space:]]+const)?[[:space:]]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]*([,)=]|$)' |
        grep -vE '[[:space:]]capability_k[[:space:]]*=' || true)
    [ -z "$masks" ] || fail "$masks" \
        "$file holds or takes a NumKong capability mask under include/ - take the kits src/ picks under it:"
}

# A raw pointer member beside a count describes one range: a span, a NumKong view or a tape says so. A C++ record
# holds no `T *name` or `T const *name` member, and a function takes no `(T const *, std::size_t)` pair. The C ABI's
# `uform_*_handle_t` records, the type-erased `void *` towers and states the verb tables pass, C-string members,
# function-pointer types, and lines marked `vendor-boundary` or `device-boundary`, where a view would cost a kernel
# registers, keep theirs. A pointer member counts only in a record that also holds a count, size, length, bytes or
# stride. The staged file is read whole, since whether a line is a member is context.
check_pointer_count_members() {
    local pointers
    pointers=$(awk '
        NR == FNR { added[$1 + 0]; next }
        {
            line = $0
            if (in_comment) { if (match(line, /\*\//)) { line = substr(line, RSTART + 2); in_comment = 0 } else next }
            gsub(/\/\*([^*]|\*[^\/])*\*\//, " ", line)
            if (match(line, /\/\*/)) { line = substr(line, 1, RSTART - 1); in_comment = 1 }
            sub(/\/\/.*/, "", line)
            if (kind[depth] == "record" &&
                line ~ /^[[:space:]]*[A-Za-z_][A-Za-z0-9_:<>, ]*[[:space:]]+[a-z_]*(count|size|length|bytes|stride)[a-z_]*[[:space:]]*(=[^;]*|\{[^}]*\})?;/)
                counted[depth] = 1
            if ((FNR in added) && $0 !~ /(vendor|device)-boundary/) {
                if (kind[depth] == "record" &&
                    line ~ /^[[:space:]]*((static|inline|constexpr)[[:space:]]+)*(const[[:space:]]+)?[A-Za-z_][A-Za-z0-9_:]*(<[^;()]*>)?([[:space:]]+const)?[[:space:]]*\*[[:space:]]*(const[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*[[:space:]]*(=[^;]*|\{[^}]*\})?;[[:space:]]*$/ &&
                    line !~ /^[[:space:]]*(const[[:space:]]+)?(void|char)([[:space:]]+const)?[[:space:]]*\*/ &&
                    line !~ /^[[:space:]]*(return|delete|using|typedef|friend|case|goto)[[:space:]]/)
                    pending[depth] = pending[depth] sprintf("line %d: %s\n", FNR, $0)
                else if (line ~ /[(,][[:space:]]*[A-Za-z_][A-Za-z0-9_:<>]*([[:space:]]+const)?[[:space:]]*\*[[:space:]]*[A-Za-z_][A-Za-z0-9_]*[[:space:]]*,[[:space:]]*(std::)?(size_t|nk_size_t)[[:space:]]+[A-Za-z_]/ &&
                         line !~ /void([[:space:]]+const)?[[:space:]]*\*[[:space:]]*(tower|state)[[:space:]]*,/ &&
                         (statement " " line) !~ /(using[[:space:]]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]*=|typedef)[^;]*\(\*/)
                    printf "line %d: %s\n", FNR, $0
            }
            statement = statement " " line
            for (position = 1; position <= length(line); ++position) {
                character = substr(line, position, 1)
                if (character == "{") {
                    ++depth
                    if (kind[depth - 1] == "code") kind[depth] = "code"
                    else if (statement ~ /(^|[^A-Za-z0-9_])(struct|class|union)[[:space:]]+(alignas\([^)]*\)[[:space:]]+)?uform_[a-z0-9_]+_handle_t([^A-Za-z0-9_]|$)/) kind[depth] = "handle"
                    else if (statement ~ /(^|[^A-Za-z0-9_])(struct|class|union)([^A-Za-z0-9_]|$)/ && statement !~ /(^|[^A-Za-z0-9_])enum([^A-Za-z0-9_]|$)/) kind[depth] = "record"
                    else if (statement ~ /(^|[^A-Za-z0-9_])(namespace|extern)([^A-Za-z0-9_]|$)/) kind[depth] = "namespace"
                    else kind[depth] = "code"
                    statement = ""
                } else if (character == "}") {
                    if (depth > 0) {
                        if (counted[depth]) printf "%s", pending[depth]
                        delete kind[depth]; delete pending[depth]; delete counted[depth]; --depth
                    }
                    statement = ""
                }
                else if (character == ";") statement = ""
            }
        }' "$staged_lines_path" "$staged_blob" || true)
    [ -z "$pointers" ] || fail "$pointers" \
        "$file passes a range as a raw pointer - hold or take a std::span, a NumKong view or a tape_view:"
}

# An engine never sleeps or yields on its own schedule: how a thread waits, spinning, yielding or parking, is the
# caller's choice, so it waits through the waiter or pause src/ passes, and src/ alone spells the sleep.
check_library_sleeps() {
    local sleeps
    sleeps=$(printf '%s\n' "$added" | blank_c_comments_preserving_columns | sed -E 's/"([^"\\]|\\.)*"//g' |
        grep -E '(^|[^A-Za-z0-9_])(nanosleep|usleep|sleep|sched_yield)[[:space:]]*\(|\bsleep_(for|until)\b|\bstd::this_thread\b' ||
        true)
    [ -z "$sleeps" ] || fail "$sleeps" \
        "$file sleeps or yields in an engine - wait through the waiter or pause src/ passes:"
}

# CUDA's `atomicAdd`-family intrinsics never name their memory order - they are relaxed at device scope, and a
# reader cannot tell whether that was chosen. Every shared word goes through `cuda::atomic_ref` from
# `<cuda/atomic>` with an explicit order, as weak as the protocol allows.
check_cuda_raw_atomics() {
    local raw
    raw=$(printf '%s\n' "$added" | blank_c_comments_preserving_columns |
        grep -E '(^|[^A-Za-z0-9_])atomic(Add|Sub|Or|And|Xor|CAS|Exch|Min|Max|Inc|Dec)(_block|_system)?\(' || true)
    [ -z "$raw" ] || fail "$raw" \
        "$file calls a CUDA atomic intrinsic - write cuda::atomic_ref<u32_t, cuda::thread_scope_device> {word}" \
        "            .fetch_add(1, cuda::std::memory_order_relaxed), naming the order at every access:"
}

# A file every GPU vendor compiles names no vendor: its symbols are `vram_*`, never a `cuda_`, `hip_` or `metal_`
# one, and a vendor's calls stay in its kits and its class units.
check_vendor_neutral() {
    local named
    named=$(printf '%s\n' "$added" | grep -E '(^|[^A-Za-z0-9_])(cuda|hip|metal)_[A-Za-z0-9_]' || true)
    [ -z "$named" ] || fail "$named" \
        "$file is shared by every GPU vendor - its symbols say vram_*, and a vendor's calls stay in its own kits:"
}

# A C verb serves every residency through the verbs its model's variant picked, and never asks which residency or
# vendor the model holds; checking that the executor matches the model is no such branch.
check_residency_branches() {
    local branching
    branching=$(printf '%s\n' "$added" | grep -E '(holds_alternative|get_if)<(ram|vram)_model|encoder_home_t::vram_|uform_gpu_vendor_[a-z]+_k|device_kind_t::|gpu_vendor_t::|(^|[^A-Za-z0-9_])vendor_k' || true)
    [ -z "$branching" ] || fail "$branching" \
        "$file branches a C verb on residency or vendor - the face serves the verb or answers unsupported_k:"
}

# Towers include their own vendor's files and shared ones only: a class unit or kernel file under `src/encoder/`
# names its vendor after `vram_`, the towers and kits under `include/uform/encoder/` name none, and a `ram_` file
# includes no `vram_` one.
check_tower_isolation() {
    local vendor crossing reached='vram_([a-z]+_)?(nvidia|amd|apple)[_.]'
    vendor=$(basename "$file" | sed -nE 's/^vram_([a-z]+_)?(nvidia|amd|apple)([_.].*)?$/\2/p')
    case "$(basename "$file")" in
    ram_*) reached='vram_' ;;
    esac
    crossing=$(grep -nE "^[[:space:]]*#[[:space:]]*(include|embed)[[:space:]]*\"([^\"]*/)?${reached}" "$staged_blob" |
        grep -vE "vram_([a-z]+_)?${vendor:-none}[_.]" || true)
    [ -z "$crossing" ] || fail "$crossing" \
        "$file reaches into another tower - towers include only their own vendor, shared headers none, and the" \
        "            host tower no device one:"
}

# Engines take kits, and `src/` alone picks them per class: nothing under `include/uform/` names a class enum or a
# class unit.
check_classes_out_of_engines() {
    local named
    named=$(printf '%s\n' "$added" | grep -E '(cpu|gpu)_class_t|_variants_' || true)
    [ -z "$named" ] || fail "$named" \
        "$file names a CPU or GPU class under include/ - an engine takes the kits src/ picks per class:"
}

# The mesh lifts out of UForm whole: `uform/core/mesh.hpp` and the multimem and InfiniBand collectives include
# system headers, the host-only core types, the device allocators, the schedule and each other, never the encoder,
# the trainer or the rest of the core.
check_mesh_isolation() {
    local reaching
    reaching=$(grep -nE '^[[:space:]]*#[[:space:]]*(include|embed)[[:space:]]*"' "$staged_blob" |
        grep -vE '"uform/core/(types\.hpp|array\.hpp|checkpoint\.hpp|multimodal_batch\.hpp|gpu_allocators\.hpp|schedule\.cuh|mesh\.hpp|multimem_[^"]+|infiniband_[^"]+)"' ||
        true)
    [ -z "$reaching" ] || fail "$reaching" \
        "$file is part of the mesh, which includes only system headers, the host-only core types," \
        "            uform/core/gpu_allocators.hpp, uform/core/schedule.cuh and the other mesh files:"
}

# A const member that locks or writes hides a mutation behind its signature, and a `const_cast` launders a
# read-only view into a writable one: such members are non-const, and a writer takes the mutable span.
check_mutable_and_const_cast() {
    local hits
    hits=$(printf '%s\n' "$added" | blank_c_comments_preserving_columns | sed -E 's/"([^"\\]|\\.)*"//g' |
        grep -E '\bmutable\b|\bconst_cast\b' || true)
    [ -z "$hits" ] || fail "$hits" \
        "$file writes through const - make the member that locks or writes non-const, and pass the" \
        "            writer the tensor's mutable span rather than casting the const one:"
}

# STL dynamic containers in the shipped library hide allocations and grow behind the caller's back; the
# standard vector and string are already refused above, and the node-based maps, sets, lists and adaptors
# go the same way. Use `st::basic_vector<T>`, kept sorted where a lookup needs it, or an `nk::tensor`;
# a vendor API that demands one carries the `vendor-boundary` marker.
check_stl_dynamic_containers() {
    local owners
    owners=$(printf '%s\n' "$added" | grep -v 'vendor-boundary' | blank_c_comments_preserving_columns |
        grep -E '\bstd::(list|forward_list|map|multimap|set|multiset|unordered_[a-z_]+|basic_string|priority_queue|stack|queue)\b' || true)
    [ -z "$owners" ] || fail "$owners" \
        "$file uses an STL dynamic container - use st::basic_vector<T>, sorted where a lookup needs it, or nk::tensor:"
}

# A range rebuilt from its own parts - `{x.data(), x.size()}`, `{rows.data(), rows.extent(0)}`,
# `{tokens.view().data(), tokens.view().size()}` or `std::span<T const>(x.data(), x.size())` - means a
# conversion or an accessor is missing: a container converts to `std::span`, NumKong tensors convert to
# views, and `sz::string` converts to its view. Pass the range itself.
check_range_reconstruction() {
    local rebuilt
    rebuilt=$(printf '%s\n' "$added" |
        grep -E '(\{|(span|string_view|_view_t|_span_t)(<.*>)?( const)?( [a-z_]+)? *\() *([A-Za-z_][A-Za-z0-9_.()>-]*)(\.|->)data\(\), *\6(\.|->)(size\(\)|numel\(\)|extent\(0\)) *[})]' || true)
    [ -z "$rebuilt" ] || fail "$rebuilt" \
        "$file rebuilds a range from its own .data()/.size() - pass the range itself," \
        "            or add the missing accessor or conversion:"
}

# Preprocessor conditionals a reader can match by eye: two levels at most, not counting the include guard,
# no `#elif` chain inside another chain, and an `#endif` that closes a pair names its condition, as in
# `#endif // UFORM_WITH_INFINIBAND`. A conditional is judged when any of its directives, or those of a
# conditional inside it, is an added line.
check_preprocessor_nesting() {
    local tangled
    tangled=$(awk '
        NR == FNR { added[$1 + 0]; next }
        pending != "" && NF {
            if ($1 == "#define" && $2 == pending) guarded = 1
            pending = ""
        }
        !/^[[:space:]]*#/ { next }
        {
            directive = $0
            sub(/^[[:space:]]*#[[:space:]]*/, "", directive)
            keyword = directive; sub(/[^a-z].*$/, "", keyword)
        }
        keyword ~ /^if(def|ndef)?$/ {
            ++level
            chain[level] = holds[level] = inner_chain[level] = 0
            touched[level] = (FNR in added)
            if (level == 1 && keyword == "ifndef" && !opened_any) { pending = directive; sub(/^ifndef[[:space:]]+/, "", pending); sub(/[[:space:]].*$/, "", pending) }
            opened_any = 1
            if (level > 1) holds[level - 1] = 1
            if (level - guarded > 2 && touched[level])
                printf "line %d: opens a third conditional level - fold two conditions into one line\n", FNR
            next
        }
        keyword == "elif" && level { chain[level] = 1; if (FNR in added) touched[level] = 1; next }
        keyword == "else" && level { if (FNR in added) touched[level] = 1; next }
        keyword == "endif" && level {
            if (FNR in added) touched[level] = 1
            is_guard = (level == 1 && guarded)
            if (!is_guard && touched[level] && chain[level] && inner_chain[level])
                printf "line %d: closes an #elif chain that holds another #elif chain\n", FNR
            if (!is_guard && touched[level] && holds[level] && $0 !~ /\/\/[[:space:]]*[^[:space:]]/)
                printf "line %d: closes a conditional that holds another - name it: #endif // <condition>\n", FNR
            if (level > 1) {
                if (chain[level]) inner_chain[level - 1] = 1
                if (touched[level]) touched[level - 1] = 1
            }
            if (is_guard) guarded = 0
            --level
            next
        }' "$staged_lines_path" "$staged_blob")
    [ -z "$tangled" ] || fail "$tangled" \
        "$file tangles its preprocessor conditionals - two levels at most, no #elif chain inside another," \
        "            and an #endif closing a nested pair names its condition:"
}

# A requires-clause names what it admits. Parentheses wrap only what the grammar needs them for, a comparison,
# a call or a negation, never names joined by && and ||; and a clause never opens with a negation: a fallback
# beside `requires X` stays unconstrained, since the constrained overload already wins wherever X holds.
check_requires_clauses() {
    local negated wrapped name='[A-Za-z_][A-Za-z0-9_:]*(<[^()&|]*>)?'
    negated=$(printf '%s\n' "$added" | grep -E '^\+[^/*]*requires[[:space:]]*\([[:space:]]*!' || true)
    [ -z "$negated" ] || fail "$negated" \
        "$file opens a requires-clause with a negation - leave the fallback unconstrained, name the" \
        "            alternative as a concept of its own, or branch with if constexpr:"
    wrapped=$(printf '%s\n' "$added" |
        grep -E "^\+[^/*]*requires[[:space:]]*\([[:space:]]*$name([[:space:]]*(&&|\|\|)[[:space:]]*$name)*[[:space:]]*\)[[:space:]]*\$" ||
        true)
    [ -z "$wrapped" ] || fail "$wrapped" \
        "$file wraps plain names in parentheses - write \`requires concept<type_> && other<type_>\`:"
}

# Rejects a print to stdout in a test body: the harness owns the output, a passing check is silent and a
# failing one reports itself to stderr through `test_suite_t::check`, so a green run reads as one line per case.
check_test_bodies_quiet() {
    local prints
    prints=$(printf '%s\n' "$added" | blank_c_comments_preserving_columns |
        grep -nE '\b(fmt::println|fmt::print|printf|puts)[[:space:]]*\(|\bstd::cout\b|\bfprintf[[:space:]]*\([[:space:]]*stdout\b' |
        grep -vE '\([[:space:]]*stderr\b' || true)
    [ -z "$prints" ] || fail "$prints" \
        "$file prints to stdout from a test body - report failures through suite.check(...), which writes" \
        "            stderr, and leave the result lines to the harness:"
}

# A test's oracle is the `check` family of test/harness.hpp, never `assert`, which compiles out wherever NDEBUG is
# defined and, where it is not, aborts the whole run instead of counting one failure.
check_test_oracle_never_compiled_out() {
    local asserts
    asserts=$(printf '%s\n' "$added" | blank_c_comments_preserving_columns |
        grep -nE '(^|[^A-Za-z0-9_])assert[[:space:]]*\(' || true)
    [ -z "$asserts" ] || fail "$asserts" \
        "$file asserts in a test - write \`suite.check_equal(count, 3u, \"rows\");\` from test/harness.hpp," \
        "            which counts the failure and never compiles out:"
}

# endregion C++ Surface and Containers

# region Build CI and Packaging

# CI workflows - every job and every step carries a `name:`. An unnamed step renders as its raw
# command in the Actions UI, and job names are what branch protection's required checks reference,
# so an anonymous one can't be pinned. A name reads as a plain phrase, never `Name (qualifier)`, and a
# matrix job's name spells every list-valued axis, since GitHub appends `(values)` to one naming none.
# Names are structure, not lines, so unlike the checks above this validates the whole staged file.
check_workflow_names() {
    local misnamed
    misnamed=$(
        < "$staged_blob" awk '
            # A name is plain when no parenthesis is left once its ${{ }} expressions are dropped.
            function check_plain(line,    name) {
                name = line; sub(/^[^:]*:[[:space:]]*/, "", name)
                line = name; gsub(/\$\{\{([^}]|\}[^}])*\}\}/, "", line)
                if (line ~ /[()]/) printf "line %d: `%s` is parenthesized\n", NR, name
            }
            # A matrix job names every list-valued axis, and at least one matrix value when it has none.
            function settle(    axis, count, i) {
                if (job == "" || !job_named || !matrix) return
                count = split(axes, axis, " ")
                for (i = 1; i <= count; ++i)
                    if (job_name !~ ("matrix\\." axis[i] "([^A-Za-z0-9_-]|$)"))
                        printf "line %d: job `%s` leaves the matrix axis `%s` out of its name\n", job_line, job, axis[i]
                if (!count && job_name !~ /matrix\./) printf "line %d: job `%s` names no matrix value\n", job_line, job
            }
            /^name:/ { check_plain($0) }
            # Jobs: two-space keys under the top-level `jobs:` section, named by a four-space `name:`.
            /^jobs:[[:space:]]*$/ { in_jobs = 1; next }
            in_jobs && /^[^ #]/ { in_jobs = 0 }
            in_jobs && /^  [A-Za-z_][A-Za-z0-9_-]*:[[:space:]]*$/ {
                if (job != "" && !job_named) printf "line %d: job `%s` has no name\n", job_line, job
                settle()
                job = substr($1, 1, length($1) - 1); job_line = NR; job_named = 0
                job_name = ""; in_strategy = 0; matrix = 0; axes = ""
            }
            in_jobs && /^    name:/ { job_named = 1; job_name = $0; check_plain($0) }
            # Matrix axes: keys two deeper than `strategy.matrix:` holding a `[a, b]` or `- a` list, never
            # the keys that appear only inside its `include` and `exclude` entries.
            matrix_at && !/^[[:space:]]*(#|$)/ {
                indent = match($0, /[^ ]/) - 1
                if (indent <= matrix_at) matrix_at = 0
                else if (indent == matrix_at + 2 && match($0, /^ *[A-Za-z_][A-Za-z0-9_-]*:/)) {
                    key = substr($0, indent + 1, RLENGTH - indent - 1); value = substr($0, RLENGTH + 1); listed = ""
                    if (key == "include" || key == "exclude") next
                    if (value ~ /^[[:space:]]*\[/) axes = axes " " key
                    else if (value ~ /^[[:space:]]*(#.*)?$/) listed = key
                } else if (listed != "" && $0 ~ /^[[:space:]]*- /) { axes = axes " " listed; listed = "" }
            }
            in_jobs && /^    [^ #]/ { in_strategy = ($0 ~ /^    strategy:/) }
            in_strategy && /^      matrix:/ { matrix = 1; matrix_at = 6; listed = "" }
            # Steps: list items two deeper than their `steps:`, named inline or by a key two deeper.
            /^[[:space:]]*steps:[[:space:]]*$/ { steps_at = index($0, "steps:") - 1; item_at = steps_at + 2; pending = 0; next }
            steps_at {
                indent = match($0, /[^ ]/) - 1
                if ($0 ~ /^[[:space:]]*(#|$)/) next
                if (indent <= steps_at) { if (pending) printf "line %d: unnamed step\n", pending; steps_at = 0; next }
                if (indent == item_at && substr($0, item_at + 1, 2) == "- ") {
                    if (pending) printf "line %d: unnamed step\n", pending
                    pending = ($0 ~ /^[[:space:]]*- name:/) ? 0 : NR
                    if (!pending) check_plain($0)
                } else if (indent == item_at + 2 && $0 ~ /^[[:space:]]*name:/) { pending = 0; check_plain($0) }
            }
            END {
                if (job != "" && !job_named) printf "line %d: job `%s` has no name\n", job_line, job
                settle()
                if (pending) printf "line %d: unnamed step\n", pending
            }
        '
    )
    [ -z "$misnamed" ] || fail "$misnamed" \
        "$file misnames a CI workflow, job or step - each carries a \`name:\` the Actions UI and branch protection" \
        "            reference, a plain phrase like \`Test \${{ matrix.os }} on QEMU\` that spells every list-valued matrix axis:"
}

# CMake spells every target, source and flag it means at the call that means it. Deriving one by replacing, slicing or
# matching out part of another string, or by editing a list in place, hides what the build compiles: pass each name as
# an argument instead, under a keyword where several kinds travel together. Building a list with `list(APPEND)` and
# testing a value with `if (... MATCHES ...)` stay free.
check_cmake_string_surgery() {
    local surgery
    surgery=$(printf '%s\n' "$added" | grep -vE '^\+?[[:space:]]*#' |
        grep -iE '(^|[^A-Za-z0-9_])(string[[:space:]]*\([[:space:]]*(REPLACE|REGEX|SUBSTRING|STRIP|TOLOWER|TOUPPER)[[:space:]]|list[[:space:]]*\([[:space:]]*(TRANSFORM|FILTER|REMOVE_ITEM|REMOVE_AT|REMOVE_DUPLICATES|SUBLIST|POP_BACK|POP_FRONT|INSERT|JOIN|SORT|REVERSE)[[:space:]]|(get_filename_component|cmake_path)[[:space:]]*\()' ||
        true)
    [ -z "$surgery" ] || fail "$surgery" \
        "$file derives a name or flag by editing a string or a list - spell each one out at its call and pass it as" \
        "            an argument, as \`uform_find_library(UFORM_AVCODEC_LIBRARY avcodec)\` takes both its names:"
}

# Rejects CMake spellings the projects agreed on: parsed arguments through `PARSE_ARGV <n> arg`, functions under the
# project prefix, lowercase locals, loop variables and internals with a trailing underscore, uppercase non-cache names
# only for CMake's own, a sibling's options, the published values or third-party inputs, and caches written once.
check_cmake_conventions() { # check_cmake_conventions <path> <staged-text> <added-line-numbers>
    local findings
    findings=$(awk -v path="$1" -v prefix="$project_include_prefix" -v siblings="$sibling_projects" \
        -v published=" $cmake_published_variables $cmake_third_party_variables " '
        function hit(rule, message) {
            if (!(rule in messages)) { order[++rules] = rule; messages[rule] = message }
            if (++hits[rule] <= 5) found[rule] = found[rule] first ": " opening "\n"
        }
        function judge(    name, arguments, tokens, count, variable, cached, forced, index_) {
            match(bare, /[A-Za-z_][A-Za-z0-9_]*/); name = tolower(substr(bare, RSTART, RLENGTH))
            arguments = substr(bare, index(bare, "(") + 1)
            sub(/\)[[:space:]]*$/, "", arguments); sub(/^[[:space:]]+/, "", arguments)
            count = split(arguments, tokens, /[[:space:]]+/)
            if (index(code, "${${")) hit("indirect", "reads a name through `${${`; return through an output parameter")
            if (name == "macro") hit("macro", "defines a `macro()`; write a `function()`")
            if (name == "cmake_parse_arguments" && arguments !~ /^PARSE_ARGV[[:space:]]+[0-9]+[[:space:]]+arg( |$)/)
                hit("parse", "parses arguments other than through `PARSE_ARGV <n> arg`")
            if (name == "function" && (index(tokens[1], prefix "_") != 1 || tokens[1] ~ /_$/))
                hit("function", "names a function without the `" prefix "_` prefix or with a trailing `_`")
            if (name == "foreach" && tokens[1] !~ /_$/) hit("foreach", "names a loop variable without a trailing `_`")
            if (name != "set" || tokens[1] ~ /^(\$|ENV\{)/) return
            variable = tokens[1]
            for (index_ = 2; index_ <= count; ++index_) {
                cached = cached || tokens[index_] == "CACHE"
                forced = forced || tokens[index_] == "FORCE"
            }
            if (cached && forced) hit("force", "forces a cache entry, which is written once")
            if (cached) return
            if (variable ~ /^[a-z_](.*[^_])?$/) hit("lowercase", "sets a lowercase local without a trailing `_`")
            if (variable ~ /^[A-Z]/ && variable !~ "^(CMAKE|" toupper(siblings) ")_" &&
                !index(published, " " variable " "))
                hit("uppercase", "sets an uppercase name outside CMake, the siblings, and the published and third-party lists")
        }
        NR == FNR { added[$1 + 0]; next }
        {
            line_code = ""; line_bare = ""
            for (position = 1; position <= length($0); ++position) {
                character = substr($0, position, 1)
                if (character == "\\") {
                    line_code = line_code substr($0, position, 2)
                    if (!quoted) line_bare = line_bare substr($0, position, 2)
                    ++position; continue
                }
                if (character == "\"") quoted = !quoted
                else if (character == "#" && !quoted) break
                else if (character == "(" && !quoted) ++depth
                else if (character == ")" && !quoted) --depth
                line_code = line_code character
                if (!quoted || character == "\"") line_bare = line_bare character
            }
            if (!open) {
                if (line_bare !~ /^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\(/) { depth = 0; next }
                open = 1; first = FNR; opening = $0; code = ""; bare = ""; touched = 0
            }
            code = code " " line_code; bare = bare " " line_bare; touched = touched || (FNR in added)
            if (depth <= 0) { if (touched) judge(); open = 0; depth = 0 }
        }
        END {
            for (index_ = 1; index_ <= rules; ++index_)
                printf "pre-commit: %s %s:\n%s", path, messages[order[index_]], found[order[index_]]
        }' \
        "$3" "$2")
    [ -z "$findings" ] && return 0
    printf '%s\n' "$findings"
    return 1
}

# The CPython bindings parse arguments and build results by hand: `PyArg_Parse*` and `Py_BuildValue` interpret a
# format string at runtime, so a wrong specifier is a crash rather than a compile error, and their error paths are
# the interpreter's rather than ours.
check_cpython_format_shortcuts() {
    local shortcuts
    shortcuts=$(printf '%s\n' "$added" | blank_c_comments_preserving_columns |
        grep -E '\b(Py_BuildValue|PyArg_Parse[A-Za-z]*|PyArg_UnpackTuple)[[:space:]]*\(' || true)
    [ -z "$shortcuts" ] || fail "$shortcuts" \
        "$file calls a format-string shortcut of the C API - walk the arguments by hand and build results with" \
        "            PyDict_New / PyLong_FromSize_t and uform_py_dict_steal_item:"
}

# `sys.version` is a display string whose shape is not contractual; every question about the
# running interpreter has a structured answer.
check_python_version_probe() {
    local probes
    probes=$(printf '%s\n' "$added" | grep -nE 'sys\.version[^_]' || true)
    [ -z "$probes" ] || fail "$probes" \
        "$file parses \`sys.version\`, a human-readable string - use \`sys.version_info\` for" \
        "            comparisons or \`platform.python_version()\` for display:"
}

# A bare `np.ndarray` annotation hides the dtype a caller must pass or gets back.
check_python_array_annotations() {
    local bare
    bare=$(printf '%s\n' "$added" | grep -vE '^\+[[:space:]]*#' |
        grep -E '(->|:)[^=#]*\b(np|numpy)\.ndarray\b' || true)
    [ -z "$bare" ] || fail "$bare" \
        "$file annotates a bare np.ndarray - name the dtype, as npt.NDArray[np.float32], or take" \
        "            npt.ArrayLike for inputs:"
}

# A module constant documents itself with a docstring on the line below, which documentation tools and
# editors show on hover, rather than a comment above that none of them read.
check_python_constant_comments() {
    local commented
    commented=$(awk '
        NR == FNR { added[$1 + 0]; next }
        /^[A-Z_][A-Z0-9_]*(: [^=]+)? *= / && previous ~ /^#/ && previous !~ /^# (region|endregion)/ &&
            ((FNR in added) || ((FNR - 1) in added)) {
            printf "line %d: %s\n", FNR, $0
        }
        { previous = $0 }' "$staged_lines_path" "$staged_blob")
    [ -z "$commented" ] || fail "$commented" \
        "$file documents a module constant with a comment above it - move the text into a docstring on" \
        "            the line below the assignment:"
}

# Rejects Rust imports out of the standard library, external crates, own crate order, or without a blank line
# between those groups and after the last one, which rustfmt leaves alone. It reads the whole source from stdin.
check_rust_use_groups() { # check_rust_use_groups <own-crate> <path> < source
    local findings
    findings=$(awk -v own="$1" -v path="$2" -v quote="'" '
        BEGIN { literal = "r#*\"|\"|" quote "(\\\\.|[^" quote "\\\\])" quote "|//|/\\*" }
        function blanks(width) { return sprintf("%" width "s", "") }
        function count(text, bracket) { return gsub(bracket, "", text) }
        function group(root) {
            if (root == "std" || root == "core" || root == "alloc") return 0
            return root == own || root == "crate" || root == "self" || root == "super" ? 2 : 1
        }
        function blank(from, to,   line) {
            for (line = from; line < to; ++line) if (source[line] ~ /[^[:space:]]/) return 0
            return 1
        }
        {
            source[NR] = $0
            text = $0; masked = ""; plain = 0
            while (text != "") {
                if (depth) {
                    if (!match(text, /\/\*|\*\//)) break
                    depth += substr(text, RSTART, 2) == "/*" ? 1 : -1
                    taken = RSTART + 1
                } else if (closer != "" && !raw) {
                    if (!match(text, /^([^"\\]|\\.)*"/)) break
                    closer = ""; taken = RLENGTH
                } else if (closer != "") {
                    if (!(taken = index(text, closer))) break
                    taken += length(closer) - 1; closer = ""
                } else if (match(text, literal)) {
                    masked = masked substr(text, 1, RSTART - 1)
                    token = substr(text, RSTART, RLENGTH); text = substr(text, RSTART); taken = RLENGTH
                    if (token == "//") break
                    if (token == "/*") depth = 1
                    else if (token ~ /"$/) { raw = token ~ /^r/; closer = "\"" substr(token, 2, RLENGTH - 2) }
                } else { plain = 1; break }
                masked = masked blanks(taken); text = substr(text, taken + 1)
            }
            code[NR] = masked (plain ? text : blanks(length(text)))
        }
        END {
            for (line = 1; line <= NR; ++line) {
                if (!match(code[line], /^ *(pub(\([^)]*\))? +)?use +(::)?[A-Za-z0-9_]+/)) continue
                head = substr(code[line], 1, RLENGTH); rest = substr(code[line], RLENGTH + 1)
                root = head; sub(/^.*[ :]/, "", root)
                for (end = line; !index(rest, ";") && end < NR; rest = code[++end]) {}
                start = line
                while (start > 1 && code[start - 1] ~ /\][[:space:]]*$/) {
                    candidate = start; nesting = 0
                    while (candidate > 1) {
                        --candidate
                        nesting += count(code[candidate], "]") - count(code[candidate], "\\[")
                        if (nesting == 0) break
                    }
                    if (code[candidate] !~ /^[[:space:]]*#\[/) break
                    start = candidate
                }
                match(head, /^ */)
                ++uses; starts[uses] = start; ends[uses] = end; indents[uses] = RLENGTH; roots[uses] = root
            }
            for (use = 1; use <= uses; ++use) {
                category = group(roots[use]); after = source[ends[use] + 1]; gsub(/^[[:space:]]+|[[:space:]]+$/, "", after)
                if (use < uses && indents[use + 1] == indents[use] && blank(ends[use] + 1, starts[use + 1])) {
                    if (group(roots[use + 1]) < category)
                        printf "%s:%d: order imports as standard library, external crates, own crate\n", path, starts[use]
                    if (group(roots[use + 1]) != category && ends[use] + 1 == starts[use + 1])
                        printf "%s:%d: separate import groups with a blank line\n", path, ends[use]
                } else if (ends[use] < NR && after != "" && after != "}")
                    printf "%s:%d: add a blank line after the last import\n", path, ends[use]
            }
        }')
    [ -z "$findings" ] && return 0
    echo "pre-commit: $2 breaks the Rust import groups - standard library, external crates, then the own crate," \
        "a blank line apart:"
    printf '%s\n' "$findings" | head -5
    return 1
}

# endregion Build CI and Packaging

# Judges a file of the library under include/ or src/, or of a harness under test/, bench/ or tools/.
judge_cuda_path() {
    # Translation units (.cu / .cpp) never OPEN a namespace block — named or anonymous. They define
    # entities already declared in the headers, so they reach the namespace with `using namespace ...;`
    # or a `namespace alias = ...;` and qualify their definitions; the `namespace X { }` body lives only
    # in the .cuh / .hpp. Matches a name-then-`{` or a bare `{`; aliases (`= ...;`), using-directives, and
    # the closing `} // namespace` all lack the opening brace and pass.
    case "$file" in
    *.cu | *.cpp)
        namespace_blocks=$(printf '%s\n' "$added" |
            grep -nE 'namespace[[:space:]]+[A-Za-z_][A-Za-z0-9_:]*[[:space:]]*\{|namespace[[:space:]]*\{' || true)
        if [ -n "$namespace_blocks" ]; then
            echo "pre-commit: $file opens a namespace block — a .cu/.cpp reaches its namespace with"
            echo "            \`using namespace ...;\` or a \`namespace alias = ...;\`, never \`namespace X { }\`:"
            printf '%s\n' "$namespace_blocks" | head -5
            rejection_count=$((rejection_count + 1))
        fi
        ;;
    esac
    chevrons=$(printf '%s\n' "$added" | grep -nE '<<<.*>>>' || true)
    runtime_includes=$(printf '%s\n' "$added" | grep -nE '#include\s*<cuda_runtime(_api)?\.h>' || true)
    # A split string literal whose fragment lacks the trailing `//` pin gets restitched by clang-format
    # into unreadable staircases; every fragment except the last must end with `" //`. CMake lists of quoted
    # paths share the shape but no clang-format pass, so only C and C++ sources are judged.
    unpinned_splits=""
    case "$file" in
    *.c | *.h | *.cu | *.cuh | *.cpp | *.hpp)
        unpinned_splits=$(printf '%s\n' "$added" | awk '
            prev ~ /"[[:space:]]*$/ && prev !~ /\/\/[[:space:]]*$/ && $0 ~ /^\+[[:space:]]*"/ { print NR": "prev }
            { prev = $0 }' || true)
        ;;
    esac
    # Banned vocabulary: one word per concept — byte-granting is `allocate`, window-granting is
    # `reserve`, contiguous regions are `buffer` / `chunk` / `plane`, and the optimizer's per-weight
    # state is not a `slot`.
    banned_words=$(printf '%s\n' "$added" | grep -inE 'carve|slab|seam|slot' || true)
    if [ -n "$banned_words" ]; then
        echo "pre-commit: $file adds banned vocabulary (carve/slab/seam/slot) — allocate/reserve/buffer/chunk/plane/boundary:"
        printf '%s\n' "$banned_words" | head -5
        rejection_count=$((rejection_count + 1))
    fi
    # Standalone repo: the internal predecessor "UFormTrain" is never named — describe behaviour directly,
    # not by lineage. Applies to every file, docs included.
    uformtrain_refs=$(printf '%s\n' "$added" | grep -in 'UFormTrain' || true)
    if [ -n "$uformtrain_refs" ]; then
        echo "pre-commit: $file references UFormTrain — the predecessor stack is not named anywhere in this repo:"
        printf '%s\n' "$uformtrain_refs" | head -5
        rejection_count=$((rejection_count + 1))
    fi
    # cstdio formatting is exception-blind and bypasses the cell's one diagnostics spelling: host text
    # goes through `format_into` + POSIX `::write`. Device code never prints: a trapping kernel records a
    # `gpu_fault_t` the host renders after the context dies, and `check_printf` refuses the rest.
    fprintf_calls=$(printf '%s\n' "$added" | grep -inE 'fprintf' || true)
    if [ -n "$fprintf_calls" ]; then
        echo "pre-commit: $file adds fprintf — host diagnostics are format_into + ::write(STDERR_FILENO, ...):"
        printf '%s\n' "$fprintf_calls" | head -5
        rejection_count=$((rejection_count + 1))
    fi
    # STL smells: this stack is single-thread-dispatch (ForkUnion pools where parallelism is real), value
    # types, and `expected<T>` ownership. `std::ranges` is a needless abstraction over the plain
    # algorithms; `std::async` / `std::mutex` / coroutines are the banned threading model; `std::function`
    # hides an allocation behind an indirect call; `std::shared_ptr` hides lifetimes behind shared
    # ownership; `std::pair` / `std::tuple` are anonymous aggregates that hide a named type (return a
    # struct, or a StringZilla slice / NumKong view for a span); `std::optional` is subsumed by `expected<T>`,
    # which carries a typed error alongside the value-or-absence. Mark a genuine vendor boundary explicitly.
    stl_smells=$(printf '%s\n' "$added" | grep -v 'vendor-boundary' |
        grep -nE 'std::ranges|std::async|std::function|std::mutex|std::shared_ptr|std::pair|std::tuple|std::optional|#include <coroutine>|\bco_(await|yield|return)\b' || true)
    if [ -n "$stl_smells" ]; then
        echo "pre-commit: $file uses a banned STL smell — std::ranges / std::async / std::mutex / coroutines /"
        echo "            std::function / std::shared_ptr / std::pair / std::tuple / std::optional are smells here:"
        printf '%s\n' "$stl_smells" | head -5
        rejection_count=$((rejection_count + 1))
    fi
    # Multidimensional tensor indexing is C++23 `tensor[row, column]`, never the `tensor(row, column)`
    # call form (device is C++23 now, so the subscript is uniform with the host). The write form
    # `name(i, j) = …` is the unambiguous tell — assigning into a parenthesised multi-index — so that is
    # what we reject; defaulted / deleted members are exempt, comment lines are exempt.
    paren_index=$(printf '%s\n' "$added" | grep -vE '^\+\s*(\*|//)' | grep -vE '= *(default|delete)' |
        grep -nE '[A-Za-z_][A-Za-z0-9_]*\([^()]*,[^()]*\)[[:space:]]*=[^=]' || true)
    if [ -n "$paren_index" ]; then
        echo "pre-commit: $file writes a tensor through the \`(row, column)\` call form — C++23 multidim"
        echo "            indexing is \`tensor[row, column]\`:"
        printf '%s\n' "$paren_index" | head -5
        rejection_count=$((rejection_count + 1))
    fi
    # Indexing a call result — `f(x)[i]`, `.data()[i]`, `.u32s()[0]` — hides the object being indexed;
    # bind the returned view/span to a named local and index that. Comment lines are exempt.
    call_indexing=$(printf '%s\n' "$added" | grep -vE '^\+\s*(\*|//)' | grep -nE '\)\[' || true)
    if [ -n "$call_indexing" ]; then
        echo "pre-commit: $file indexes a function-call result (\`()[...]\`) — bind the returned span to"
        echo "            a named local first:"
        printf '%s\n' "$call_indexing" | head -5
        rejection_count=$((rejection_count + 1))
    fi
    if [ -n "$chevrons" ]; then
        echo "pre-commit: $file adds triple-chevron kernel launches — use launch_kernel / cuLaunchKernel"
        echo "            (<<<>>> fails silently and links libcudart; https://ashvardanian.com/posts/less-wrong-cuda-hello-world/):"
        printf '%s\n' "$chevrons" | head -5
        rejection_count=$((rejection_count + 1))
    fi
    if [ -n "$runtime_includes" ]; then
        echo "pre-commit: $file adds a CUDA Runtime API include — the CUDA sources are Driver-API only:"
        printf '%s\n' "$runtime_includes" | head -5
        rejection_count=$((rejection_count + 1))
    fi
    if [ -n "$unpinned_splits" ]; then
        echo "pre-commit: $file splits a string literal without the trailing \`//\` pin — clang-format"
        echo "            will restitch the fragments into a staircase; pin every fragment but the last:"
        printf '%s\n' "$unpinned_splits" | head -5
        rejection_count=$((rejection_count + 1))
    fi
    # Exception policy: std::string / std::vector allocate through throwing paths, and this codebase is
    # built noexcept end-to-end — a bad_alloc anywhere would terminate. Outside tests, strings are
    # sz::string_t (try_append / try_push_back) and dynamic arrays are st::basic_vector<T>.
    case "$file" in
    test/* | bench/* | tools/*) ;;
    *)
        # Lines marked `vendor-boundary` are exempt: some vendor APIs, like cuDF's source paths, force
        # std containers in their signatures; the marker keeps those exemptions explicit and greppable.
        std_containers=$(printf '%s\n' "$added" | grep -v 'vendor-boundary' |
            grep -nE 'std::(string|vector)\b' || true)
        if [ -n "$std_containers" ]; then
            echo "pre-commit: $file adds std::string / std::vector — throwing containers violate the"
            echo "            strict no-exceptions policy; use sz::string_t / st::basic_vector<T> instead:"
            printf '%s\n' "$std_containers" | head -5
            rejection_count=$((rejection_count + 1))
        fi
        # API boundaries take sz::string_view_t (or typed views/spans), never raw C strings; only true
        # vendor boundaries touch `char const *` internally, and they carry the marker.
        c_string_parameters=$(printf '%s\n' "$added" | grep -v 'vendor-boundary' |
            grep -nE '[(,] *char const \*' || true)
        case "$file" in
        *.cuh | *.hpp)
            if [ -n "$c_string_parameters" ]; then
                echo "pre-commit: $file adds a \`char const *\` parameter — API boundaries take"
                echo "            sz::string_view_t; mark genuine vendor boundaries explicitly:"
                printf '%s\n' "$c_string_parameters" | head -5
                rejection_count=$((rejection_count + 1))
            fi
            # Member documentation is Doxygen: a bare `//` line directly above a declaration (a member or
            # a type) is the banned doc style — those entities get `/** @brief ... */`. Scoped to headers
            # on purpose: members and types are declared here, whereas the same `Type name = …;` shape in a
            # `.cu` is a local variable inside a function body, and a `//` note above it is a legal
            # implementation note. The `\+?` prefix in each pattern matches the `+` that `git diff`
            # prepends to every added line.
            member_doc_comments=$(printf '%s\n' "$added" |
                awk '/^\+?[[:space:]]*\/\/[^\/]/ { pending=$0; next } \
                     /^\+?[[:space:]]*[A-Za-z_][A-Za-z0-9_:<>,* ]* [A-Za-z_][A-Za-z0-9_]* *([={;]|$)/ && pending { print pending; pending="" ; next } \
                     { pending="" }' || true)
            if [ -n "$member_doc_comments" ]; then
                echo "pre-commit: $file documents a declaration with a bare \`//\` comment — docs are"
                echo "            /** @brief ... */ blocks; \`//\` is for implementation notes inside bodies:"
                printf '%s\n' "$member_doc_comments" | head -5
                rejection_count=$((rejection_count + 1))
            fi
            ;;
        esac
        ;;
    esac
}

# Python sources: ruff lint (docstring shape D/google, nested-import PLC0415, import order I) and the
# ALL-CAPS-emphasis ban, on their CHANGED lines only — the same added-lines discipline as the C++ checks
# (legacy migrates on its own schedule). Ruff is tool-guarded like the cmake / clang gates: a missing ruff
# (not synced into the uv env) skips rather than blocks. The emphasis grep is pure shell and always runs.
ruff_cmd=""
if command -v ruff > /dev/null 2>&1; then
    ruff_cmd="ruff"
elif command -v uv > /dev/null 2>&1 && uv run --no-sync ruff --version > /dev/null 2>&1; then
    ruff_cmd="uv run --no-sync ruff"
fi

# Judges a Python source on its changed lines.
judge_python_path() {
    # No ALL-CAPS-for-emphasis in docstrings and comments, protocol and token names excepted.
    emphasis=$(printf '%s\n' "$added" |
        grep -nE '\b(ONLY|NEVER|ALWAYS|EVERY|WHOLE|SHARDABLE|DISTINCT|STREAMS|MATERIALISES?)\b' || true)
    if [ -n "$emphasis" ]; then
        echo "pre-commit: $file uses ALL-CAPS emphasis on a changed line — lowercase it:"
        printf '%s\n' "$emphasis" | head -5
        rejection_count=$((rejection_count + 1))
    fi
    # ruff findings intersected with the changed line numbers (docstring D / nested-import PLC0415 / imports I).
    if [ -n "$ruff_cmd" ] && [ -n "$added_lines" ]; then
        new_findings=$($ruff_cmd check --quiet --output-format=concise "$file" 2> /dev/null |
            awk -F: 'NR == FNR { keep[$1 + 0]; next } ($2 + 0) in keep' "$staged_lines_path" -)
        if [ -n "$new_findings" ]; then
            echo "pre-commit: $file has ruff docstring or import findings on its changed lines:"
            printf '%s\n' "$new_findings" | head -8
            rejection_count=$((rejection_count + 1))
        fi
    fi
}

# C++ sources must satisfy the checked-in .clang-format on their changed lines, so legacy formatting migrates on its
# own schedule. The hunks come from the rename-aware diff, so a moved file is judged only on the lines it changed. Needs
# clang-format 22 for the profile's BinPackLongBracedList and BreakAdjacentStringLiterals options.
check_clang_format_on_changed_lines() {
    local ranges drift
    command -v clang-format > /dev/null 2>&1 && [ -f .clang-format ] || return 0
    # A hunk deleting the first lines starts at 0, a line clang-format refuses and that has nothing to format.
    ranges=$(grep -vx -e '--lines=0:0' "$results_directory/$ordinal.ranges" 2> /dev/null) || return 0
    drift=$(clang-format --dry-run -Werror --assume-filename="$file" $ranges < "$staged_blob" 2>&1 | grep -F ': error:') ||
        return 0
    fail "$drift" "$file is not clang-format clean on its changed lines - run \`git clang-format --staged\`," \
        "            or \`clang-format -i $file\` for the whole file, then restage:"
}

judge_path() {
    local file=$staged_path staged_blob=$results_directory/index/$staged_path
    local staged_lines_path=$results_directory/$ordinal.lines
    added=
    [ ! -f "$results_directory/$ordinal.added" ] || added=$(< "$results_directory/$ordinal.added")
    [ -s "$staged_lines_path" ] || echo > "$staged_lines_path"
    added_lines=$(< "$staged_lines_path")
    case "$file" in
    include/* | src/* | test/* | tools/* | bench/*) judge_cuda_path ;;
    esac
    case "$file" in
    *.py) judge_python_path ;;
    esac
    case "$file" in
    # Every C and C++ source: prose, Doxygen and the shared vocabulary.
    *.c | *.h | *.hpp | *.cpp | *.cc | *.cxx | *.cu | *.cuh | *.hip)
        check_ascii_arrows
        check_glued_arrows
        check_ids_capitalized
        check_backward_references
        check_prose_comment_width
        check_prose_paragraph_filled
        check_region_labels
        check_region_lengths
        check_param_directions
        check_markdown_doxygen
        check_doxygen_glued
        check_doxygen_in_line_comments
        check_doxygen_trailers
        check_section_spacing
        check_docblock_spacing
        check_continuation_hanging_indent
        check_lone_brief
        check_brief_length
        check_file_header
        check_docblock_brackets
        check_preprocessor_nesting
        check_hand_ceils
        check_trailing_returns
        check_iterator_laundering
        check_namespace_directories
        check_namespace_reopened
        ;;&
    # Declarations in headers are already judged by the bare-comment check of the CUDA cells.
    *.hpp | *.cuh) ;;
    *.c | *.h | *.cpp | *.cc | *.cxx | *.cu | *.hip) check_bare_member_docs ;;
    esac
    case "$file" in
    # Every C source: its includes group the C library first, and its macros stay object-like.
    *.c | *.h)
        check_include_groups
        check_function_like_macros
        ;;&
    # Every C++ source: the C ABI header keeps its C idioms.
    *.hpp | *.cpp | *.cc | *.cxx | *.cu | *.cuh | *.hip)
        check_include_groups
        check_qualified_namespace
        check_c_limit_macros
        check_template_parameter_underscores
        check_template_type_suffixes
        check_suffixed_template_names
        check_private_member_underscores
        check_requires_clauses
        check_function_like_macros
        check_stl_streams
        check_printf
        check_partial_prints
        check_deque
        check_memcpy
        check_libc_qualified
        check_flat_subscripts
        check_call_slicing
        check_range_reconstruction
        check_data_null_probe
        check_call_chained_call
        check_gcc_atomics
        check_standard_atomics
        check_numkong_dispatch
        check_mutable_and_const_cast
        check_clang_format_on_changed_lines
        ;;&
    *.cu | *.cuh | *.hip)
        check_host_threads
        ;;&
    # HIP has no `cuda::atomic_ref` to suggest, so only the CUDA sources answer for their atomics.
    *.cu | *.cuh)
        check_cuda_raw_atomics
        ;;&
    # The shipped library: the C ABI under c/uform/, the engines under include/uform/ and the sources under src/. The
    # stand-in under src_stub/ is built on the C++ standard library alone, so only the C++ rules above judge it.
    c/*.h | include/uform/*.hpp | include/uform/*.cuh | src/*.cuh | src/*.hpp | src/*.cu | src/*.cpp | src/*.hip)
        check_boolean_parameters
        ;;&
    include/uform/*.hpp | include/uform/*.cuh | src/*.cuh | src/*.hpp | src/*.cu | src/*.cpp | src/*.hip)
        check_stl_dynamic_containers
        check_budget_writers
        check_in_house_never_throws
        check_in_house_noexcept
        check_inheritance_and_locks
        check_pointer_count_members
        ;;&
    # The engines wait through the waiters src/ picks and run through the kits it picks, so only they never sleep or
    # yield on their own, nor hold a capability mask.
    include/uform/*.hpp | include/uform/*.cuh)
        check_library_sleeps
        check_capability_masks_in_engines
        ;;&
    # The code every GPU vendor shares, and the C verbs above every residency.
    include/uform/encoder/tower.hpp | include/uform/encoder/vram_tower.hpp | include/uform/encoder/entries.hpp | \
        src/encoder_punned.hpp | src/encoder_specializations.hpp | src/encode.cpp | src/encode.hpp | \
        src/encode_media.cpp | src/model.cpp)
        check_vendor_neutral
        ;;&
    src/encode.cpp | src/encode.hpp | src/encode_media.cpp | src/model.cpp)
        check_residency_branches
        ;;&
    include/uform/encoder/* | src/encoder/*)
        check_tower_isolation
        ;;&
    include/uform/*)
        check_classes_out_of_engines
        ;;&
    include/uform/core/mesh.hpp | include/uform/core/multimem_* | include/uform/core/infiniband_* | src/core/multimem_* | \
        src/core/infiniband_*)
        check_mesh_isolation
        ;;&
    # The harnesses, then the suites' bodies, whose harness alone writes the result lines.
    test/harness.hpp | bench/harness.hpp)
        check_harness_namespace
        check_test_oracle_never_compiled_out
        ;;
    test/*.cpp | test/*.hpp | test/*.cu | test/*.cuh)
        check_test_bodies_quiet
        check_test_oracle_never_compiled_out
        check_widened_accumulation
        ;;
    bench/*.cpp | bench/*.cu)
        check_widened_accumulation
        ;;
    esac
    case "$file" in
    *.md)
