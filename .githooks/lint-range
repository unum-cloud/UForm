#!/usr/bin/env bash
#
# UForm lint-range: run the pre-commit checks over every change since a base revision, the way a commit would see them.
#
#   .githooks/lint-range              every tracked file, as if the tree were one commit
#   .githooks/lint-range main-dev     only what this branch adds
set -euo pipefail

base=${1:-}
if [[ -z $base || $base == 0000000000000000000000000000000000000000 ]]; then
    base=$(git commit-tree "$(git hash-object -t tree /dev/null)" -m empty)
fi

# The hook diffs the index against HEAD, so it runs in a scratch worktree whose HEAD is the base and whose index and
# files hold this tree, leaving the author's own index and files as they are.
index=$(mktemp)
scratch=$(mktemp -d)
trap 'git worktree remove --force "$scratch" > /dev/null 2>&1; rm -rf "$index" "$scratch"' EXIT
cp "$(git rev-parse --git-path index)" "$index"
GIT_INDEX_FILE=$index git add -A
snapshot=$(git commit-tree "$(GIT_INDEX_FILE=$index git write-tree)" -m snapshot)
git worktree add --quiet --detach "$scratch" "$base"
cd "$scratch"
git checkout --quiet --no-overlay "$snapshot" -- .
.githooks/pre-commit
