{
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.formatOnSave": true,
    "editor.rulers": [120]
  },
  "[cuda-cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.formatOnSave": true,
    "editor.rulers": [120]
  },
  "[markdown]": {
    "editor.defaultFormatter": "yzhang.markdown-all-in-one",
    "editor.formatOnSave": false,
    "editor.rulers": [120]
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.rulers": [120]
  },
  "clangd.arguments": [
    "--background-index",
    "--header-insertion=never"
  ],
  "cSpell.words": [
    "arange",
    "ashvardanian",
    "astype",
    "avcodec",
    "avformat",
    "avutil",
    "bfloat",
    "Blackwell",
    "cccl",
    "cpublas",
    "cublasLt",
    "cudf",
    "cudnn",
    "cufile",
    "cumsum",
    "cuvid",
    "dtype",
    "embs",
    "finfo",
    "hooksPath",
    "Hopper",
    "huggingface",
    "ibverbs",
    "keepdim",
    "kvikio",
    "linalg",
    "logits",
    "Matryoshka",
    "multimem",
    "multimodal",
    "ndarray",
    "nppig",
    "numkong",
    "numpy",
    "nvcc",
    "nvcomp",
    "nvcuvid",
    "nvimgcodec",
    "nvjpeg",
    "nvrtc",
    "opset",
    "parquet",
    "preprocess",
    "pretrained",
    "probs",
    "ptxas",
    "pypi",
    "pytest",
    "randn",
    "rerank",
    "reranker",
    "rmm",
    "RMSNorm",
    "safetensors",
    "SIMD",
    "softmax",
    "stringzilla",
    "swresample",
    "torchvision",
    "uform",
    "unimodal",
    "unsqueeze",
    "Vardanian",
    "yyjson",
    "zstandard"
  ],
  "files.associations": {
    "*.cu": "cuda-cpp",
    "*.cuh": "cuda-cpp"
  },
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/__pycache__": true,
    "**/build*/**": true,
    "data/**": true
  },
  "search.exclude": {
    "**/__pycache__": true,
    ".venv/**": true,
    "build*/**": true,
    "data/**": true
  }
}
