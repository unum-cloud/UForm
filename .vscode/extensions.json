{
  // Recommendations that make the settings.json above work. clangd is the C/C++/CUDA language server
  // (reads build/compile_commands.json); Nsight provides the cuda-gdb debugger used in launch.json;
  // ruff is the Python linter/formatter; CMake Tools drives the build; the YAML extension formats YAML.
  "recommendations": [
    "llvm-vs-code-extensions.vscode-clangd",
    "nvidia.nsight-vscode-edition",
    "ms-vscode.cmake-tools",
    "charliermarsh.ruff",
    "ms-python.python",
    "redhat.vscode-yaml",
    "streetsidesoftware.code-spell-checker"
  ],
  // The MS C/C++ extension ships its own IntelliSense engine that conflicts with clangd; it is
  // intentionally not recommended so a fresh clone does not run two language servers.
  "unwantedRecommendations": [
    "ms-vscode.cpptools"
  ]
}
