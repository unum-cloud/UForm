{
  "version": "0.2.0",
  "configurations": [
    {
      // Debug a CUDA test binary with cuda-gdb (needs the Nsight extension + a Debug/RelWithDebInfo
      // build so device symbols exist: cmake -B build -DCMAKE_BUILD_TYPE=RelWithDebInfo). Duplicate the
      // config and change `program` for the other cuda_test_* / uform_train binaries.
      "name": "CUDA: cuda_test_mesh",
      "type": "cuda-gdb",
      "request": "launch",
      "program": "${workspaceFolder}/build/cuda_test_mesh"
    },
    {
      "name": "Python: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "name": "Python: pytest current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}",
        "-s",
        "-x"
      ],
      "console": "integratedTerminal"
    }
  ]
}
