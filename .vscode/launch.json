{
  "version": "0.2.0",
  "configurations": [
    {
      // Debug a CUDA test binary with cuda-gdb (needs the Nsight extension + a build with device line
      // tables: cmake --preset relwithdebinfo && cmake --build --preset relwithdebinfo). Duplicate the
      // config and change `program` for the other uform_test_* / uform_base binaries.
      "name": "CUDA: uform_test_mesh",
      "type": "cuda-gdb",
      "request": "launch",
      "program": "${workspaceFolder}/build_relwithdebinfo/uform_test_mesh"
    },
    {
      "name": "Python: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "name": "Python: pytest current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}",
        "-s",
        "-x"
      ],
      "console": "integratedTerminal"
    }
  ]
}
