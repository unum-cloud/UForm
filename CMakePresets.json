{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Ninja, a build tree named after the preset, a compilation database for the language server, the host codecs, and any compiler launchers the environment names, like CMAKE_CXX_COMPILER_LAUNCHER=ccache. Pin the compiler path or UFORM_CUDA_ARCH of one machine in a CMakeUserPresets.json on top.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build_${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CUDA_HOST_COMPILER": "clang++",
        "CMAKE_C_COMPILER_LAUNCHER": "$env{CMAKE_C_COMPILER_LAUNCHER}",
        "CMAKE_CXX_COMPILER_LAUNCHER": "$env{CMAKE_CXX_COMPILER_LAUNCHER}",
        "CMAKE_CUDA_COMPILER_LAUNCHER": "$env{CMAKE_CUDA_COMPILER_LAUNCHER}",
        "UFORM_WITH_CODECS": "ON"
      }
    },
    {
      "name": "linux",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "windows",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug - unoptimized host code",
      "description": "Unoptimized host code with full DWARF, every host library, tool and suite.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "UFORM_BUILD_SHARED": "ON",
        "UFORM_BUILD_TEST": "ON",
        "UFORM_BUILD_TOOLS": "ON"
      }
    },
    {
      "name": "check",
      "inherits": "base",
      "displayName": "Check - fastest compile cycle",
      "description": "Does it still compile, nothing more: -O0 without debug information on the host and in ptxas where CUDA is added, cicc at -O1 because nvcc 13.4 rejects __dp4a at -O0, with warnings as errors.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O0 -g0 -DNDEBUG",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O0 -g0 -DNDEBUG",
        "CMAKE_CUDA_FLAGS_RELWITHDEBINFO": "-O0 -Xcicc -O1 -Xptxas -O0 -DNDEBUG",
        "UFORM_BUILD_SHARED": "ON",
        "UFORM_BUILD_TEST": "ON",
        "UFORM_BUILD_TOOLS": "ON",
        "UFORM_WERROR": "ON"
      }
    },
    {
      "name": "relwithdebinfo",
      "inherits": "base",
      "displayName": "RelWithDebInfo - optimized with symbols and device line tables",
      "description": "Optimized, with host DWARF and -lineinfo device line tables for cuda-gdb and Nsight. The tree `.clangd` reads.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CUDA_FLAGS_RELWITHDEBINFO": "-O2 -g -lineinfo -DNDEBUG",
        "UFORM_BUILD_SHARED": "ON",
        "UFORM_BUILD_TEST": "ON",
        "UFORM_BUILD_TOOLS": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release - every host target",
      "description": "The host libraries and the conformance suites, fully optimized, with build paths remapped so the binaries name none.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS": "-ffile-prefix-map=${sourceDir}=.",
        "CMAKE_CXX_FLAGS": "-ffile-prefix-map=${sourceDir}=.",
        "CMAKE_CUDA_FLAGS": "-Xcompiler=-ffile-prefix-map=${sourceDir}=.",
        "UFORM_BUILD_SHARED": "ON",
        "UFORM_BUILD_TEST": "ON",
        "UFORM_BUILD_TOOLS": "ON"
      }
    },
    {
      "name": "cuda",
      "inherits": "release",
      "displayName": "CUDA - every target with the NVIDIA residency",
      "description": "The release build plus the NVIDIA residency, the trainer, the mesh and the loaders, for the release set of Ampere-through-Blackwell codes.",
      "cacheVariables": {
        "UFORM_CUDA_ARCH": "all",
        "UFORM_BUILD_TRAIN": "ON"
      }
    },
    {
      "name": "rocm",
      "inherits": "release",
      "displayName": "ROCm - every target with the AMD residency",
      "description": "The release build plus the AMD residency, its HIP units compiled by ROCm's own Clang.",
      "cacheVariables": {
        "CMAKE_HIP_COMPILER": "/opt/rocm/llvm/bin/clang++",
        "UFORM_ROCM_ARCH": "all"
      }
    },
    {
      "name": "library",
      "inherits": "base",
      "displayName": "Library - the C library for the host alone",
      "description": "The C library alone, fully optimized, without the trainer or the conformance suites, with build paths remapped.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS": "-ffile-prefix-map=${sourceDir}=.",
        "CMAKE_CXX_FLAGS": "-ffile-prefix-map=${sourceDir}=.",
        "CMAKE_CUDA_FLAGS": "-Xcompiler=-ffile-prefix-map=${sourceDir}=.",
        "UFORM_BUILD_SHARED": "ON"
      }
    },
    {
      "name": "stub_library",
      "inherits": "library",
      "displayName": "Stub Library - the C headers over a library that reports every verb unsupported",
      "cacheVariables": {
        "UFORM_BUILD_SHARED": "OFF",
        "UFORM_BUILD_STUB": "ON"
      }
    },
    {
      "name": "swift",
      "inherits": "base",
      "displayName": "Swift - the XCFramework or artifact bundle SwiftPM links",
      "description": "The CPU library packed for SwiftPM, or with UFORM_BUILD_STUB the stand-in the Swift suite runs against. An Apple slice names its SDK and architecture, here or with -D, and any other target its Swift triples in UFORM_SWIFT_TRIPLES.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "UFORM_BUILD_SWIFT": "ON",
        "UFORM_SWIFT_SDK": "macosx",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0"
      }
    },
    {
      "name": "cuda_rocm_library",
      "inherits": "library",
      "displayName": "CUDA and ROCm Library - the C library with both GPU residencies",
      "description": "Clang compiles the host code of both vendors: NVCC hosts on it, and ROCm's own Clang compiles the HIP units.",
      "cacheVariables": {
        "CMAKE_HIP_COMPILER": "/opt/rocm/llvm/bin/clang++",
        "UFORM_CUDA_ARCH": "all",
        "UFORM_ROCM_ARCH": "all",
        "UFORM_BUILD_TRAIN": "ON"
      }
    },
    {
      "name": "linux_cuda_rocm",
      "inherits": [
        "library",
        "linux"
      ],
      "displayName": "Linux CUDA and ROCm - the inference library with both GPU residencies and no trainer",
      "description": "Both vendors' encoder variants in one shared library that links no GPU runtime of its own, which the vendor-boundary check reads with readelf.",
      "cacheVariables": {
        "CMAKE_HIP_COMPILER": "/opt/rocm/llvm/bin/clang++",
        "UFORM_CUDA_ARCH": "all",
        "UFORM_ROCM_ARCH": "all"
      }
    },
    {
      "name": "wasm32_emscripten",
      "inherits": "library",
      "displayName": "WebAssembly Emscripten - the C library for browsers and Node",
      "toolchainFile": "${sourceDir}/cmake/toolchain-wasm32-emscripten.cmake",
      "cacheVariables": {
        "CMAKE_C_COMPILER": null,
        "CMAKE_CXX_COMPILER": null,
        "CMAKE_CUDA_HOST_COMPILER": null,
        "UFORM_MARCH": "v128",
        "UFORM_WITH_CODECS": "OFF",
        "CMAKE_CROSSCOMPILING_EMULATOR": "node"
      }
    },
    {
      "name": "wasm64_emscripten",
      "inherits": "library",
      "displayName": "WebAssembly Emscripten 64 - the extended C library for isolated pages and Node",
      "toolchainFile": "${sourceDir}/cmake/toolchain-wasm64-emscripten.cmake",
      "cacheVariables": {
        "CMAKE_C_COMPILER": null,
        "CMAKE_CXX_COMPILER": null,
        "CMAKE_CUDA_HOST_COMPILER": null,
        "UFORM_MARCH": "v128relaxed",
        "UFORM_WITH_CODECS": "OFF",
        "CMAKE_CROSSCOMPILING_EMULATOR": "node"
      }
    },
    {
      "name": "wasm32_wasi",
      "inherits": "library",
      "displayName": "WebAssembly WASI - the C library for standalone runtimes",
      "toolchainFile": "${sourceDir}/cmake/toolchain-wasm32-wasi.cmake",
      "cacheVariables": {
        "CMAKE_C_COMPILER": null,
        "CMAKE_CXX_COMPILER": null,
        "CMAKE_CUDA_HOST_COMPILER": null,
        "UFORM_MARCH": "v128",
        "UFORM_WITH_CODECS": "OFF"
      }
    },
    {
      "name": "android_arm64",
      "inherits": "library",
      "displayName": "Android ARM64 - the C library through the NDK's toolchain",
      "toolchainFile": "$env{ANDROID_NDK_ROOT}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_C_COMPILER": null,
        "CMAKE_CXX_COMPILER": null,
        "CMAKE_CUDA_HOST_COMPILER": null,
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-28",
        "UFORM_WITH_CODECS": "OFF"
      }
    },
    {
      "name": "msvc2026_x64",
      "inherits": [
        "library",
        "windows"
      ],
      "displayName": "Windows x64 - the C library with Visual Studio 2026",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_C_COMPILER": null,
        "CMAKE_CXX_COMPILER": null,
        "CMAKE_CUDA_HOST_COMPILER": null,
        "CMAKE_C_FLAGS": "/DWIN32 /D_WINDOWS /pathmap:${sourceDir}=.",
        "CMAKE_CXX_FLAGS": "/DWIN32 /D_WINDOWS /EHsc /pathmap:${sourceDir}=.",
        "CMAKE_CUDA_FLAGS": null,
        "UFORM_WITH_CODECS": "OFF"
      }
    },
    {
      "name": "machine",
      "hidden": true,
      "inherits": [
        "base",
        "linux"
      ],
      "description": "One machine: its CPU floor, every kernel-library capability spelled as 1 or 0, and its one GPU code.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "UFORM_BUILD_SHARED": "ON",
        "UFORM_BUILD_TRAIN": "ON",
        "UFORM_BUILD_TEST": "OFF",
        "UFORM_BUILD_BENCH": "OFF",
        "UFORM_MULTIVERSIONED": "OFF"
      }
    },
    {
      "name": "xeon4_hopper",
      "inherits": "machine",
      "displayName": "Xeon 4 with Hopper - compile only",
      "cacheVariables": {
        "UFORM_MARCH": "sapphirerapids",
        "UFORM_CUDA_ARCH": "90a",
        "NUMKONG_TARGET_HASWELL": "1",
        "NUMKONG_TARGET_SKYLAKE": "1",
        "NUMKONG_TARGET_ICELAKE": "1",
        "NUMKONG_TARGET_GENOA": "1",
        "NUMKONG_TARGET_SAPPHIRE": "1",
        "NUMKONG_TARGET_SAPPHIREAMX": "1",
        "NUMKONG_TARGET_GRANITEAMX": "0",
        "NUMKONG_TARGET_DIAMOND": "0",
        "NUMKONG_TARGET_DIAMONDAMX": "0",
        "NUMKONG_TARGET_TURIN": "0",
        "NUMKONG_TARGET_ALDER": "1",
        "NUMKONG_TARGET_SIERRA": "0",
        "STRINGZILLA_TARGET_WESTMERE": "1",
        "STRINGZILLA_TARGET_GOLDMONT": "1",
        "STRINGZILLA_TARGET_HASWELL": "1",
        "STRINGZILLA_TARGET_SKYLAKE": "1",
        "STRINGZILLA_TARGET_ICELAKE": "1",
        "FORKUNION_TARGET_X86_PAUSE": "1",
        "FORKUNION_TARGET_X86_TPAUSE": "1",
        "FORKUNION_TARGET_X86_CLDEMOTE": "1",
        "FORKUNION_TARGET_X86_CMPCCXADD": "0",
        "FORKUNION_TARGET_X86_RAOINT": "0"
      }
    },
    {
      "name": "xeon6_blackwell",
      "inherits": "machine",
      "displayName": "Xeon 6 with Blackwell - compile only",
      "cacheVariables": {
        "UFORM_MARCH": "graniterapids",
        "UFORM_CUDA_ARCH": "100f",
        "NUMKONG_TARGET_HASWELL": "1",
        "NUMKONG_TARGET_SKYLAKE": "1",
        "NUMKONG_TARGET_ICELAKE": "1",
        "NUMKONG_TARGET_GENOA": "1",
        "NUMKONG_TARGET_SAPPHIRE": "1",
        "NUMKONG_TARGET_SAPPHIREAMX": "1",
        "NUMKONG_TARGET_GRANITEAMX": "1",
        "NUMKONG_TARGET_DIAMOND": "0",
        "NUMKONG_TARGET_DIAMONDAMX": "0",
        "NUMKONG_TARGET_TURIN": "0",
        "NUMKONG_TARGET_ALDER": "1",
        "NUMKONG_TARGET_SIERRA": "0",
        "STRINGZILLA_TARGET_WESTMERE": "1",
        "STRINGZILLA_TARGET_GOLDMONT": "1",
        "STRINGZILLA_TARGET_HASWELL": "1",
        "STRINGZILLA_TARGET_SKYLAKE": "1",
        "STRINGZILLA_TARGET_ICELAKE": "1",
        "FORKUNION_TARGET_X86_PAUSE": "1",
        "FORKUNION_TARGET_X86_TPAUSE": "1",
        "FORKUNION_TARGET_X86_CLDEMOTE": "1",
        "FORKUNION_TARGET_X86_CMPCCXADD": "0",
        "FORKUNION_TARGET_X86_RAOINT": "0"
      }
    },
    {
      "name": "grace_hopper",
      "inherits": "machine",
      "displayName": "Grace with Hopper - compile only",
      "description": "Grace's 128-bit SVE gains nothing over NEON, so every SVE capability is off.",
      "cacheVariables": {
        "UFORM_MARCH": "grace",
        "UFORM_CUDA_ARCH": "90a",
        "NUMKONG_TARGET_NEON": "1",
        "NUMKONG_TARGET_NEONHALF": "1",
        "NUMKONG_TARGET_NEONSDOT": "1",
        "NUMKONG_TARGET_NEONBFDOT": "1",
        "NUMKONG_TARGET_NEONFHM": "1",
        "NUMKONG_TARGET_SVE": "0",
        "NUMKONG_TARGET_SVEHALF": "0",
        "NUMKONG_TARGET_SVEBFDOT": "0",
        "NUMKONG_TARGET_SVESDOT": "0",
        "NUMKONG_TARGET_SVE2": "0",
        "NUMKONG_TARGET_NEONFP8": "0",
        "NUMKONG_TARGET_SME": "0",
        "NUMKONG_TARGET_SMEF64": "0",
        "NUMKONG_TARGET_SMEBI32": "0",
        "STRINGZILLA_TARGET_NEON": "1",
        "STRINGZILLA_TARGET_NEONAES": "1",
        "STRINGZILLA_TARGET_NEONSHA": "1",
        "STRINGZILLA_TARGET_SVE": "0",
        "STRINGZILLA_TARGET_SVE2": "0",
        "STRINGZILLA_TARGET_SVE2AES": "0",
        "FORKUNION_TARGET_ARM64_YIELD": "1",
        "FORKUNION_TARGET_ARM64_WFET": "0",
        "FORKUNION_TARGET_ARM64_DC_CVAC": "1",
        "FORKUNION_TARGET_ARM64_PRFM": "1",
        "FORKUNION_TARGET_ARM64_LSE": "1",
        "FORKUNION_TARGET_ARM64_RCPC": "1"
      }
    },
    {
      "name": "vera_rubin",
      "inherits": "machine",
      "displayName": "Vera with Rubin - compile only",
      "description": "Olympus cores need Clang 22 or GCC 15 and CUDA 13.4 names no Rubin code, so it compiles 100f; WFET is on, as no compiler macro reports it, and SVE off, as on Grace.",
      "cacheVariables": {
        "UFORM_MARCH": "olympus",
        "UFORM_CUDA_ARCH": "100f",
        "NUMKONG_TARGET_NEON": "1",
        "NUMKONG_TARGET_NEONHALF": "1",
        "NUMKONG_TARGET_NEONSDOT": "1",
        "NUMKONG_TARGET_NEONBFDOT": "1",
        "NUMKONG_TARGET_NEONFHM": "1",
        "NUMKONG_TARGET_SVE": "0",
        "NUMKONG_TARGET_SVEHALF": "0",
        "NUMKONG_TARGET_SVEBFDOT": "0",
        "NUMKONG_TARGET_SVESDOT": "0",
        "NUMKONG_TARGET_SVE2": "0",
        "NUMKONG_TARGET_NEONFP8": "1",
        "NUMKONG_TARGET_SME": "0",
        "NUMKONG_TARGET_SMEF64": "0",
        "NUMKONG_TARGET_SMEBI32": "0",
        "STRINGZILLA_TARGET_NEON": "1",
        "STRINGZILLA_TARGET_NEONAES": "1",
        "STRINGZILLA_TARGET_NEONSHA": "1",
        "STRINGZILLA_TARGET_SVE": "0",
        "STRINGZILLA_TARGET_SVE2": "0",
        "STRINGZILLA_TARGET_SVE2AES": "0",
        "FORKUNION_TARGET_ARM64_YIELD": "1",
        "FORKUNION_TARGET_ARM64_WFET": "1",
        "FORKUNION_TARGET_ARM64_DC_CVAC": "1",
        "FORKUNION_TARGET_ARM64_PRFM": "1",
        "FORKUNION_TARGET_ARM64_LSE": "1",
        "FORKUNION_TARGET_ARM64_RCPC": "1"
      }
    },
    {
      "name": "venice_mi450",
      "inherits": "machine",
      "displayName": "EPYC Venice with MI450 - compile only",
      "description": "Clang 22 names no Zen 6 core, so it compiles at znver5 and spells the rows GCC 16's znver6 implies; gfx1250 covers MI450X and MI455X.",
      "cacheVariables": {
        "UFORM_MARCH": "znver5",
        "UFORM_ROCM_ARCH": "gfx1250",
        "UFORM_BUILD_TRAIN": "OFF",
        "NUMKONG_TARGET_HASWELL": "1",
        "NUMKONG_TARGET_SKYLAKE": "1",
        "NUMKONG_TARGET_ICELAKE": "1",
        "NUMKONG_TARGET_GENOA": "1",
        "NUMKONG_TARGET_SAPPHIRE": "1",
        "NUMKONG_TARGET_SAPPHIREAMX": "0",
        "NUMKONG_TARGET_GRANITEAMX": "0",
        "NUMKONG_TARGET_DIAMOND": "0",
        "NUMKONG_TARGET_DIAMONDAMX": "0",
        "NUMKONG_TARGET_TURIN": "1",
        "NUMKONG_TARGET_ALDER": "1",
        "NUMKONG_TARGET_SIERRA": "1",
        "STRINGZILLA_TARGET_WESTMERE": "1",
        "STRINGZILLA_TARGET_GOLDMONT": "1",
        "STRINGZILLA_TARGET_HASWELL": "1",
        "STRINGZILLA_TARGET_SKYLAKE": "1",
        "STRINGZILLA_TARGET_ICELAKE": "1",
        "FORKUNION_TARGET_X86_PAUSE": "1",
        "FORKUNION_TARGET_X86_TPAUSE": "0",
        "FORKUNION_TARGET_X86_CLDEMOTE": "1",
        "FORKUNION_TARGET_X86_CMPCCXADD": "0",
        "FORKUNION_TARGET_X86_RAOINT": "0"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "check",
      "configurePreset": "check"
    },
    {
      "name": "relwithdebinfo",
      "configurePreset": "relwithdebinfo"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "cuda",
      "configurePreset": "cuda"
    },
    {
      "name": "rocm",
      "configurePreset": "rocm"
    },
    {
      "name": "library",
      "configurePreset": "library"
    },
    {
      "name": "stub_library",
      "configurePreset": "stub_library"
    },
    {
      "name": "swift",
      "configurePreset": "swift"
    },
    {
      "name": "cuda_rocm_library",
      "configurePreset": "cuda_rocm_library"
    },
    {
      "name": "linux_cuda_rocm",
      "configurePreset": "linux_cuda_rocm",
      "targets": [
        "uform_shared"
      ]
    },
    {
      "name": "wasm32_emscripten",
      "configurePreset": "wasm32_emscripten"
