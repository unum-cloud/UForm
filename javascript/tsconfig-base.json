{
  "compileOnSave": false,
  "exclude": ["node_modules", "dist"],
  "include": [
    "node-gyp-build.d.ts",
    "library.ts",
    "types.ts",
    "model.ts",
    "encode.ts",
    "train.ts",
    "uform.ts",
    "wasm.ts"
  ],
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "esModuleInterop": true,
    "lib": ["esnext"],
    "moduleResolution": "node",
    "noFallthroughCasesInSwitch": true,
    "pretty": true,
    "rootDir": ".",
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "types": ["node"]
  }
}
